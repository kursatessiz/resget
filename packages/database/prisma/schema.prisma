// Multi-tenant schema of the restaurant ordering network. Every tenant-scoped
// table carries restaurant_id and every query filters by it (CLAUDE.md).
// Anything a restaurant configures (menu, tables, fee policies, service
// areas, plans, credit packages) is data, never an enum; enums below are
// lifecycle states only.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum MembershipStatus {
  INVITED
  ACTIVE
  PASSIVE
}

enum InviteChannel {
  SHOWN
  WHATSAPP
  SMS
}

enum OtpPurpose {
  LOGIN
  INVITE
}

enum OrderChannel {
  TABLE_QR
  RESTAURANT_SITE
  MARKETPLACE
  PHONE
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum DeliveryMode {
  RESTAURANT_COURIER
  THIRD_PARTY_API
  NONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  READY
  HANDED_TO_COURIER
  OUT_FOR_DELIVERY
  ARRIVING
  DELIVERED
  PICKED_UP
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_RESTAURANT
  REJECTED
  REFUNDED
}

/// One courier leaving the restaurant with one or more orders (docs/SIPARIS_VE_SEVK.md).
enum DeliveryTripStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  EN_ROUTE
  ARRIVING
  DELIVERED
  FAILED
  REMOVED
}

enum StopSequenceMode {
  MANUAL
  OPTIMIZED
}

enum PaymentMode {
  OWN_POS
  PLATFORM_PSP
}

enum PaymentConnectionStatus {
  PENDING_VERIFICATION
  ACTIVE
  FAILED
  DISABLED
}

enum CommissionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  ONLINE_CARD
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  MEAL_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGED_BACK
}

enum OrderRefundSource {
  CANCELLATION
  STAFF
  CLAIM
  PROVIDER
  CHARGEBACK
}

enum OrderClaimStatus {
  OPEN
  APPROVED
  DECLINED
  ESCALATED
}

enum LedgerEntryType {
  GROSS_SALE
  DISCOUNT
  DELIVERY_FEE
  COURIER_COST
  PLATFORM_COMMISSION
  COMMISSION_VAT
  PSP_FEE
  WITHHOLDING_TAX
  REFUND
  CHARGEBACK
  COMMISSION_REVERSAL
  COMMISSION_VAT_REVERSAL
  ADJUSTMENT
  RESTAURANT_PAYABLE
}

enum LoyaltyTransactionType {
  EARN
  WELCOME
  REDEEM
  REVERSAL
  ADJUSTMENT
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutStatus {
  SCHEDULED
  SENT
  SETTLED
  FAILED
}

/// Customer churn classes (packages/shared/src/churn.ts); kept by order placement and the churn sweep.
enum ChurnRisk {
  NEW
  ACTIVE
  NOT_RETURNED
  AT_RISK
  LOST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MessageChannel {
  SMS
  WHATSAPP
  PUSH
  EMAIL
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

/// Marketing campaign lifecycle (docs/KAMPANYALAR.md).
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CampaignApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MessageTransactionType {
  PURCHASE
  GRANT
  DEBIT
  REFUND
  EXPIRY
}

enum DeliveryRequestStatus {
  QUOTED
  REQUESTED
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

enum QrScanOutcome {
  VIEWED_MENU
  STARTED_ORDER
  PLACED_ORDER
  REGISTERED
}

enum FeatureFlagScope {
  GLOBAL
  RESTAURANT
}

enum DocumentType {
  TERMS_OF_SERVICE
  PRIVACY_NOTICE
  RESTAURANT_AGREEMENT
  MARKETING_CONSENT
}

// ---------------------------------------------------------------------------
// Identity: users are global and identified by phone; a Membership links a
// user to a restaurant with a role. Customers are users too (a guest who
// registers from a table QR becomes a User with no Membership).
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  /// E.164
  phone        String    @unique
  fullName     String
  email        String?
  locale       String?
  isSuperAdmin Boolean   @default(false)
  /// Set when the person deleted their account (docs/KISISEL_VERI.md); the row stays, anonymised, for kept records.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships                Membership[]
  addresses                  CustomerAddress[]
  orders                     Order[]
  consents                   Consent[]
  restaurantCustomers        RestaurantCustomer[]
  otpCodes                   OtpCode[]
  pushDevices                PushDevice[]
  savedPaymentMethods        SavedPaymentMethod[]
  invitesCreated             InviteToken[]        @relation("InviteCreatedBy")
  statusChanges              OrderStatusHistory[]
  tripsCreated               DeliveryTrip[]
  paymentsCollected          Payment[]            @relation("PaymentCollectedBy")
  refundsCreated             OrderRefund[]        @relation("OrderRefundCreatedBy")
  claimsDecided              OrderClaim[]         @relation("OrderClaimDecidedBy")
  contactActivities          ContactActivity[]    @relation("ContactActivityActor")
  auditLogs                  AuditLog[]
  campaignsCreated           Campaign[]           @relation("CampaignCreatedBy")
  campaignApprovalsRequested Campaign[]           @relation("CampaignApprovalRequestedBy")
  campaignApprovalsDecided   Campaign[]           @relation("CampaignApprovalDecidedBy")
  apiKeysCreated             RestaurantApiKey[]   @relation("ApiKeyCreatedBy")
  aiUsages                   AiUsage[]
  oauthStates                OAuthState[]
  socialAccounts             SocialAccount[]
  socialPosts                SocialPost[]

  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  userId    String?
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// Marketplace visitors asking for a district that is not open yet; one counter per district (docs/PLATFORM_YONETIMI.md).
model MarketplaceInterest {
  id          String   @id @default(uuid())
  countryCode String
  city        String
  district    String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([countryCode, city, district])
  @@map("marketplace_interest")
}

model ServiceArea {
  id                 String    @id @default(uuid())
  countryCode        String
  city               String
  district           String
  /// Phase 0 launches one district at a time; restaurants outside a launched area are onboarded but not listed in the marketplace.
  isLaunched         Boolean   @default(false)
  launchedAt         DateTime?
  /// Restaurants with a sellable menu the district should reach before it opens (docs/PLATFORM_YONETIMI.md).
  launchTarget       Int       @default(30)
  /// Districts of the same city that border this one (docs/YOL_HARITASI.md); entered in the console.
  neighbourDistricts String[]  @default([])
  createdAt          DateTime  @default(now())

  restaurants Restaurant[]

  @@unique([countryCode, city, district])
  @@map("service_areas")
}

model Restaurant {
  id                     String    @id @default(uuid())
  slug                   String    @unique
  name                   String
  legalName              String?
  taxId                  String?
  countryCode            String
  currency               String
  timezone               String
  defaultLocale          String    @default("tr")
  serviceAreaId          String?
  isActive               Boolean   @default(true)
  /// The platform's own tenant for platform marketing (docs/PAZARLAMA.md); at most one row, never listed, never orders.
  isPlatform             Boolean   @default(false)
  /// The restaurant's partner code for inviting other restaurants (docs/RESTORAN_TAVSIYE.md); made on first ask.
  partnerCode            String?   @unique
  /// Listed in the consumer marketplace (requires a launched service area and an approved menu).
  isListed               Boolean   @default(false)
  /// Set while an overdue commission invoice keeps the restaurant out of the marketplace; cleared when it is settled.
  listingSuspendedAt     DateTime?
  /// Marketplace listing review (docs/PLATFORM_YONETIMI.md): when the restaurant asked, when the console decided, and why.
  listingRequestedAt     DateTime?
  listingReviewedAt      DateTime?
  listingReviewNote      String?
  /// The saved card commission invoices are collected from (docs/FATURALAMA.md).
  billingPaymentMethodId String?
  /// Own host of the ordering page (docs/VITRIN.md); served only once DNS is verified and the plan allows it.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  /// Running total of customer ratings (docs/VITRIN.md), so the marketplace lists the average without a scan.
  ratingCount            Int       @default(0)
  ratingSum              Int       @default(0)

  /// Platform take rate on gross order value; 100 = 1 percent. Changed only by the super admin.
  commissionBps        Int          @default(100)
  /// Who collects card payments (docs/ODEME.md): the restaurant's own virtual POS (default) or the platform's PSP.
  paymentMode          PaymentMode  @default(OWN_POS)
  /// PLATFORM_PSP only: the provider's contracted fee for this restaurant, passed through at cost (docs/MUTABAKAT.md).
  pspPercentBps        Int          @default(0)
  pspFixedMinor        Int          @default(0)
  /// How this restaurant moves food by default; per order it can differ.
  deliveryMode         DeliveryMode @default(RESTAURANT_COURIER)
  /// Preferred third-party courier network when deliveryMode is THIRD_PARTY_API.
  courierProviderId    String?
  /// How the quoted courier fee becomes the customer's delivery fee (DeliveryFeePolicySchema in shared).
  deliveryFeePolicy    Json?
  /// Delivery zone (DeliveryZoneSchema in shared): radius, minimum basket, fee by distance band; applied while delivery_zones is on.
  deliveryZone         Json?
  /// Own-courier dispatch tuning (DispatchSettingsSchema in shared): speed, detour, arrival radius, stops per trip.
  dispatchSettings     Json?
  /// Slots for scheduled orders (SchedulingSettingsSchema in shared, docs/ILERI_TARIHLI_SIPARIS.md); null means off.
  schedulingSettings   Json?
  /// Customer notification preferences (NotificationSettingsSchema in shared): order updates on or off, channel, SMS fallback.
  notificationSettings Json?
  /// Order availability (docs/SIPARIS_VE_SEVK.md): consumer orders are refused until this instant; null when not paused.
  ordersPausedUntil    DateTime?
  /// Busy mode: extra preparation minutes customers see, while busyUntil lies ahead.
  busyExtraMinutes     Int          @default(0)
  busyUntil            DateTime?

  logoUrl      String?
  themePrimary String  @default("#0092CD")

  onboardedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceArea          ServiceArea?               @relation(fields: [serviceAreaId], references: [id])
  courierProvider      CourierProvider?           @relation(fields: [courierProviderId], references: [id])
  billingPaymentMethod SavedPaymentMethod?        @relation("RestaurantBillingCard", fields: [billingPaymentMethodId], references: [id], onDelete: SetNull)
  branches             Branch[]
  memberships          Membership[]
  roleTemplates        RoleTemplate[]
  inviteTokens         InviteToken[]
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  tables               DiningTable[]
  qrScanEvents         QrScanEvent[]
  customers            RestaurantCustomer[]
  orders               Order[]
  payments             Payment[]
  orderRefunds         OrderRefund[]
  orderClaims          OrderClaim[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  paymentConnection    PaymentProviderConnection?
  mealCardConnections  MealCardConnection[]
  commissionInvoices   CommissionInvoice[]
  subscription         RestaurantSubscription?
  messageWallets       MessageWallet[]
  messageLogs          MessageLog[]
  deliveryRequests     DeliveryRequest[]
  deliveryTrips        DeliveryTrip[]
  deliveryStops        DeliveryStop[]
  courierLocations     CourierLocation[]
  featureFlags         FeatureFlag[]
  auditLogs            AuditLog[]
  campaigns            Campaign[]
  campaignSendLimit    CampaignSendLimit?
  aiBudget             AiBudget?
  aiUsage              AiUsage[]
  oauthStates          OAuthState[]
  socialAccounts       SocialAccount[]
  metaLeads            MetaLead[]
  socialPosts          SocialPost[]
  loyaltyProgram       LoyaltyProgram?
  campaignSegments     CampaignSegmentPreset[]
  apiKeys              RestaurantApiKey[]
  webhooks             RestaurantWebhook[]
  orderRatings         OrderRating[]
  loyaltyTransactions  LoyaltyTransaction[]
  coupons              Coupon[]
  referralProgram      ReferralProgram?
  referralRewards      ReferralReward[]
  feedbackSettings     FeedbackSettings?
  feedbackCases        FeedbackCase[]
  npsResponses         NpsResponse[]
  partnerReferralsMade PartnerReferral[]          @relation("PartnerReferrer")
  partnerReferredBy    PartnerReferral?           @relation("PartnerReferee")
  posConnection        PosConnection?
  posOrderSyncs        PosOrderSync[]
  pipelineStages       PipelineStage[]
  contactActivities    ContactActivity[]
  contactTasks         ContactTask[]
  visitors             Visitor[]
  contactConsents      ContactConsent[]
  consentConfirmations ConsentConfirmation[]
  marketingSettings    MarketingSettings?
  emailDomains         EmailDomain[]
  emailSuppressions    EmailSuppression[]
  segments             Segment[]
  journeys             Journey[]
  adConnections        AdConnection[]
  adSpend              AdSpendDaily[]
  sitePages            SitePage[]
  touchpoints          Touchpoint[]
  conversionEvents     ConversionEvent[]
  couponRedemptions    CouponRedemption[]

  @@index([serviceAreaId, isListed])
  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  addressLine  String
  city         String
  district     String
  postalCode   String?
  lat          Float?
  lng          Float?
  phone        String?
  /// Weekly opening hours, per weekday, as { mon: [["09:00","22:00"]], ... }.
  openingHours Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables        DiningTable[]
  orders        Order[]
  deliveryTrips DeliveryTrip[]

  @@index([restaurantId])
  @@map("branches")
}

model RoleTemplate {
  id           String   @id @default(uuid())
  restaurantId String
  /// Key of a default template (owner, manager, counter, kitchen) or null for a custom role.
  templateKey  String?
  /// Set on locked system roles (platform:<role> on the platform tenant); nobody edits or assigns them from the panel.
  systemKey    String?
  name         String
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions RoleTemplatePermission[]
  memberships Membership[]

  @@unique([restaurantId, name])
  @@map("role_templates")
}

model RoleTemplatePermission {
  roleTemplateId String
  permissionKey  String

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionKey])
  @@map("role_template_permissions")
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  restaurantId   String
  roleTemplateId String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roleTemplate    RoleTemplate            @relation(fields: [roleTemplateId], references: [id])
  courierTrips    DeliveryTrip[]
  courierLocation CourierLocation?
  locationSamples CourierLocationSample[]
  ownedContacts   RestaurantCustomer[]    @relation("ContactOwner")
  assignedTasks   ContactTask[]           @relation("TaskAssignee")

  @@unique([userId, restaurantId])
  @@index([restaurantId, status])
  @@map("memberships")
}

model InviteToken {
  id              String        @id @default(uuid())
  restaurantId    String
  createdByUserId String
  phone           String
  fullName        String
  roleTemplateId  String
  token           String        @unique
  channel         InviteChannel @default(SHOWN)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([restaurantId, phone])
  @@map("invite_tokens")
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id             String   @id @default(uuid())
  restaurantId   String
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  /// Ordering windows (OpeningHours shape, docs/OGUN_SAATLERI.md); null means whenever the restaurant takes orders.
  availableHours Json?
  /// Kitchen station the section's items go to on the kitchen display (docs/MUTFAK_EKRANI.md); null for the shared screen.
  kitchenStation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id            String   @id @default(uuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  /// Gross price in the restaurant currency's minor unit, VAT included.
  priceMinor    Int
  currency      String
  vatRateBps    Int
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Declared allergens and dietary tags (ALLERGENS, DIETARY_TAGS in shared; docs/ALERJENLER.md).
  allergens     String[] @default([])
  dietaryTags   String[] @default([])
  /// Portions left while menu_stock is on (docs/STOK.md); null means not counted.
  stockQuantity Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([restaurantId, categoryId, sortOrder])
  @@map("menu_items")
}

model ModifierGroup {
  id         String   @id @default(uuid())
  menuItemId String
  name       String
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceDeltaMinor Int      @default(0)
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// ---------------------------------------------------------------------------
// Table QR: the acquisition surface (docs/MASA_QR.md)
// ---------------------------------------------------------------------------

model DiningTable {
  id           String   @id @default(uuid())
  restaurantId String
  branchId     String
  label        String
  /// Printed in the QR; rotating it invalidates old stickers.
  qrToken      String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scanEvents  QrScanEvent[]
  touchpoints Touchpoint[]
  orders      Order[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@map("dining_tables")
}

model QrScanEvent {
  id           String        @id @default(uuid())
  restaurantId String
  tableId      String?
  /// Anonymous browser session; never a phone number.
  sessionId    String
  outcome      QrScanOutcome
  userId       String?
  orderId      String?
  createdAt    DateTime      @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([sessionId])
  @@map("qr_scan_events")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model CustomerAddress {
  id          String   @id @default(uuid())
  userId      String
  label       String
  addressLine String
  city        String
  district    String
  postalCode  String?
  lat         Float?
  lng         Float?
  note        String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

/// The restaurant's own customer list: the lock-in of the SaaS layer. One row per (restaurant, user).
model RestaurantCustomer {
  id                 String        @id @default(uuid())
  restaurantId       String
  userId             String
  /// Null for a contact who never ordered (a CRM prospect, docs/CRM.md).
  firstChannel       OrderChannel?
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  orderCount         Int           @default(0)
  lifetimeGrossMinor Int           @default(0)
  tags               String[]      @default([])
  note               String?
  marketingOptIn     Boolean       @default(false)
  /// When the customer gave or withdrew marketing consent (docs/KAMPANYALAR.md); the flag is the current state.
  marketingOptInAt   DateTime?
  marketingOptOutAt  DateTime?
  /// Unguessable handle of the one-click opt-out link in every campaign message.
  marketingToken     String?       @unique
  /// Loyalty balance (docs/SADAKAT.md); every change is a loyalty_transactions row.
  loyaltyPoints      Int           @default(0)
  /// First time the customer earned points here; the welcome bonus is paid once, at that moment.
  loyaltyJoinedAt    DateTime?
  /// CRM fields (docs/CRM.md): tenant data about the contact; the phone stays on the user.
  email              String?
  company            String?
  city               String?
  district           String?
  source             String?
  stageId            String?
  ownerMembershipId  String?
  lastActivityAt     DateTime?
  /// A business (merchant or tradesperson); only matters for the TR merchant exemption (docs/RIZA.md).
  isBusiness         Boolean       @default(false)
  /// Channels a campaign may reach now, derived from the consent history and the tenant's policy.
  consentChannels    String[]      @default([])
  /// Churn class against the customer's own ordering rhythm (docs/KAYIP_RISKI.md); null for a contact who never ordered.
  churnRisk          ChurnRisk?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignRecipients   CampaignRecipient[]
  loyaltyTransactions  LoyaltyTransaction[]
  couponRedemptions    CouponRedemption[]
  stage                PipelineStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  owner                Membership?           @relation("ContactOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  activities           ContactActivity[]
  tasks                ContactTask[]
  visitors             Visitor[]
  touchpoints          Touchpoint[]
  conversionEvents     ConversionEvent[]
  consents             ContactConsent[]
  consentConfirmations ConsentConfirmation[]
  segmentMembers       SegmentMember[]
  journeyRuns          JourneyRun[]
  metaLeads            MetaLead[]
  referralCode         Coupon?               @relation("ReferralCode")
  rewardCoupons        Coupon[]              @relation("RewardCoupon")
  referralsMade        ReferralReward[]      @relation("Referrer")
  referredBy           ReferralReward[]      @relation("ReferredFriend")

  @@unique([restaurantId, userId])
  @@index([restaurantId, lastOrderAt])
  @@index([restaurantId, marketingOptIn])
  @@index([restaurantId, churnRisk])
  @@map("restaurant_customers")
}

/// A marketing send to a segment of the restaurant's own opted-in customers (PRO, docs/KAMPANYALAR.md).
model Campaign {
  id                        String                 @id @default(uuid())
  restaurantId              String
  name                      String
  channel                   MessageChannel
  body                      String
  status                    CampaignStatus         @default(DRAFT)
  /// CampaignSegmentSchema in shared: who receives it.
  segment                   Json?
  /// A saved segment (segments v2); when set it decides the audience instead of `segment`.
  segmentId                 String?
  /// Campaigns v2 (docs/KAMPANYALAR.md): email subject, the B side of an A/B test, send time and attribution window.
  subject                   String?
  variantBody               String?
  variantSubject            String?
  /// Share of the audience that receives variant B, in percent; null means no test.
  variantSharePct           Int?
  /// FIXED or BEST_HOUR (CAMPAIGN_SEND_TIME_MODES in shared).
  sendTimeMode              String                 @default("FIXED")
  attributionDays           Int                    @default(3)
  scheduledAt               DateTime?
  startedAt                 DateTime?
  finishedAt                DateTime?
  audienceCount             Int                    @default(0)
  sentCount                 Int                    @default(0)
  failedCount               Int                    @default(0)
  skippedCount              Int                    @default(0)
  /// Why the runner paused (INSUFFICIENT_CREDITS) or the last provider error.
  lastError                 String?
  createdByUserId           String?
  /// Send approval (docs/ONAYLAR.md): who asked, who decided; any edit sets it back to NONE.
  approvalStatus            CampaignApprovalStatus @default(NONE)
  approvalRequestedByUserId String?
  approvalRequestedAt       DateTime?
  approvalDecidedByUserId   String?
  approvalDecidedAt         DateTime?
  approvalNote              String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy           User?               @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvalRequestedBy User?               @relation("CampaignApprovalRequestedBy", fields: [approvalRequestedByUserId], references: [id], onDelete: SetNull)
  approvalDecidedBy   User?               @relation("CampaignApprovalDecidedBy", fields: [approvalDecidedByUserId], references: [id], onDelete: SetNull)
  segmentRef          Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients          CampaignRecipient[]

  @@index([restaurantId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// Recipient caps the console sets for a tenant's campaigns (docs/ONAYLAR.md); null means no limit.
model CampaignSendLimit {
  restaurantId    String   @id
  maxPerCampaign  Int?
  maxPerDay       Int?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("campaign_send_limits")
}

/// Monthly AI studio token budget the console sets for a tenant (docs/YAPAY_ZEKA.md); absent means the default.
model AiBudget {
  restaurantId      String   @id
  monthlyTokenLimit Int
  updatedByUserId   String?
  updatedAt         DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("ai_budgets")
}

/// One AI studio draft request: tokens and the kind only; neither the brief nor the drafts are stored.
model AiUsage {
  id           String   @id @default(uuid())
  restaurantId String
  actorUserId  String?
  kind         String
  model        String
  inputTokens  Int
  outputTokens Int
  redactions   Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("ai_usage")
}

/// One OAuth consent round trip in flight (docs/ENTEGRASYON_MERKEZI.md): single use, bound to the tenant and the user, short lived.
model OAuthState {
  id           String    @id @default(uuid())
  state        String    @unique
  restaurantId String
  userId       String
  provider     String
  returnPath   String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_states")
}

/// A social account a tenant connected with OAuth (a Facebook page, an Instagram business account); the token is encrypted.
model SocialAccount {
  id                String    @id @default(uuid())
  restaurantId      String
  provider          String
  kind              String
  externalId        String
  name              String
  encryptedToken    String
  scopes            String[]  @default([])
  enabled           Boolean   @default(false)
  /// Facebook pages only: Lead Ads leads of this page are imported (docs/LEAD_ADS.md).
  leadsEnabled      Boolean   @default(false)
  status            String    @default("ACTIVE")
  tokenExpiresAt    DateTime?
  connectedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  connectedBy User?              @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  leads       MetaLead[]
  postTargets SocialPostTarget[]

  @@unique([restaurantId, provider, externalId])
  @@index([provider, externalId])
  @@map("social_accounts")
}

/// A Lead Ads lead (docs/LEAD_ADS.md): ids and import status only; the answers go to the CRM contact.
model MetaLead {
  id              String    @id @default(uuid())
  restaurantId    String
  socialAccountId String?
  leadgenId       String
  pageId          String
  formId          String?
  adId            String?
  /// RECEIVED, IMPORTED, SKIPPED or FAILED (META_LEAD_STATUSES in shared).
  status          String    @default("RECEIVED")
  attempts        Int       @default(0)
  /// Machine code of the last failure or skip (LEAD_REASONS in shared).
  reason          String?
  nextAttemptAt   DateTime  @default(now())
  customerId      String?
  receivedAt      DateTime  @default(now())
  importedAt      DateTime?

  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  customer      RestaurantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, leadgenId])
  @@index([restaurantId, receivedAt])
  @@index([status, nextAttemptAt])
  @@map("meta_leads")
}

/// A post for the tenant's connected social accounts (docs/SOSYAL_YAYIN.md); each account is a target with its own outcome.
model SocialPost {
  id              String    @id @default(uuid())
  restaurantId    String
  createdByUserId String?
  body            String
  /// Public address of the post's image (social_post_images), absolute like the logo's.
  imageUrl        String?
  /// SOCIAL_POST_STATUSES in shared.
  status          String    @default("DRAFT")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  /// Held by the publisher while it runs; a stale lease means a crashed run and is taken over.
  leaseUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  targets    SocialPostTarget[]
  image      SocialPostImage?

  @@index([restaurantId, createdAt])
  @@index([status, scheduledAt])
  @@map("social_posts")
}

model SocialPostTarget {
  id              String    @id @default(uuid())
  postId          String
  socialAccountId String?
  /// The account's name and kind when the post was written; kept after a disconnect.
  accountName     String
  kind            String
  /// SOCIAL_TARGET_STATUSES in shared.
  status          String    @default("PENDING")
  externalPostId  String?
  reason          String?
  attempts        Int       @default(0)
  publishedAt     DateTime?

  post          SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([postId, socialAccountId])
  @@map("social_post_targets")
}

/// A post's image, kept in the database rather than on disk; served by its random id (docs/SOSYAL_YAYIN.md).
model SocialPostImage {
  id          String   @id @default(uuid())
  postId      String   @unique
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("social_post_images")
}

/// A named audience filter the restaurant reuses across campaigns (CampaignSegmentSchema in shared).
model CampaignSegmentPreset {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  segment      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("campaign_segments")
}

/// A restaurant's API key (docs/API_ERISIMI.md): the secret is stored only as a hash; the key holds a permission subset.
model RestaurantApiKey {
  id              String    @id @default(uuid())
  restaurantId    String
  /// Public lookup part of the token (rsk_<keyId>_<secret>).
  keyId           String    @unique
  name            String
  secretHash      String
  permissions     String[]  @default([])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("restaurant_api_keys")
}

/// The customer's rating of a completed order (docs/VITRIN.md); one per order, given from the tracking page.
model OrderRating {
  id           String   @id @default(uuid())
  orderId      String   @unique
  restaurantId String
  score        Int
  comment      String?
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("order_ratings")
}

/// A URL the restaurant's own system receives order changes at (docs/API_ERISIMI.md); the signing secret is encrypted.
model RestaurantWebhook {
  id              String    @id @default(uuid())
  restaurantId    String
  url             String
  events          String[]  @default([])
  secretEncrypted String
  isActive        Boolean   @default(true)
  /// Consecutive failed deliveries; the hook pauses itself past the limit.
  failureCount    Int       @default(0)
  lastDeliveryAt  DateTime?
  lastStatus      Int?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([restaurantId, createdAt])
  @@map("restaurant_webhooks")
}

/// One attempt chain of one event to one webhook; retried with backoff by the runner.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  restaurantId   String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  responseStatus Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  sentAt         DateTime?

  webhook RestaurantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model CampaignRecipient {
  id               String                  @id @default(uuid())
  campaignId       String
  customerId       String
  status           CampaignRecipientStatus @default(PENDING)
  messageLogId     String?
  errorCode        String?
  sentAt           DateTime?
  /// A or B (campaigns v2); A when the campaign has no test.
  variant          String                  @default("A")
  /// BEST_HOUR: the recipient is not sent before this moment.
  dueAt            DateTime?
  /// The recipient's first order within the attribution window, credited to this campaign (last message wins).
  convertedOrderId String?                 @unique
  convertedAt      DateTime?
  /// Items gross of that order at placement, in the restaurant currency's minor unit.
  revenueMinor     Int?
  createdAt        DateTime                @default(now())

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer       RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  convertedOrder Order?             @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([customerId, sentAt])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Orders and money (docs/MUTABAKAT.md)
// ---------------------------------------------------------------------------

/// Loyalty rules of one restaurant (docs/SADAKAT.md); a PRO feature, the row stays when the plan lapses.
model LoyaltyProgram {
  id               String   @id @default(uuid())
  restaurantId     String   @unique
  enabled          Boolean  @default(false)
  earnPoints       Int      @default(1)
  earnStepMinor    Int
  redeemPoints     Int      @default(100)
  redeemValueMinor Int
  minOrderMinor    Int      @default(0)
  maxDiscountBps   Int      @default(5000)
  welcomePoints    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

/// Append-only point movements; the customer's loyaltyPoints is the running balance.
model LoyaltyTransaction {
  id              String                 @id @default(uuid())
  restaurantId    String
  customerId      String
  orderId         String?
  type            LoyaltyTransactionType
  /// Signed: positive earns, negative spends.
  points          Int
  balanceAfter    Int
  memo            String?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([orderId, type])
  @@map("loyalty_transactions")
}

model Order {
  id             String          @id @default(uuid())
  restaurantId   String
  branchId       String
  customerUserId String?
  tableId        String?
  channel        OrderChannel
  /// The ordering link the customer came from (docs/SIPARIS_BAGLANTILARI.md): a key of ORDER_SOURCES; null when none.
  source         String?
  fulfillment    FulfillmentType
  deliveryMode   DeliveryMode    @default(NONE)
  status         OrderStatus     @default(PLACED)
  currency       String

  // Amounts in minor units, snapshot of computeOrderSettlement() at placement.
  itemsGrossMinor         Int
  itemsVatMinor           Int
  deliveryFeeMinor        Int            @default(0)
  discountMinor           Int            @default(0)
  discountFundedBy        String?
  chargedToCustomerMinor  Int
  commissionBps           Int
  platformCommissionMinor Int
  commissionVatMinor      Int            @default(0)
  pspFeeMinor             Int            @default(0)
  pspFeeBearer            String         @default("RESTAURANT")
  withholdingMinor        Int            @default(0)
  courierCostMinor        Int            @default(0)
  courierBearer           String?
  restaurantPayableMinor  Int
  /// Payment mode at placement; decides whether the commission is invoiced (OWN_POS) or deducted (PLATFORM_PSP).
  paymentMode             PaymentMode    @default(OWN_POS)
  /// OWN_POS: commission + VAT the restaurant owes for this order. PLATFORM_PSP: 0.
  platformReceivableMinor Int            @default(0)
  /// Payment intent at placement (docs/YEMEK_KARTI.md); the payments rows carry what actually happened.
  paymentMethod           PaymentMethod?
  /// Meal card issuer code when paymentMethod is MEAL_CARD.
  paymentProvider         String?

  /// Delivery address at the time of the order (never a live reference).
  addressSnapshot           Json?
  customerNote              String?
  rejectReason              String?
  /// Unguessable handle of the public tracking page (/t/<token>); set for every new order.
  trackingToken             String?   @unique
  /// Four digits the customer reads to the restaurant's courier at the door (docs/TESLIMAT_KODU.md); delivery orders only.
  deliveryCode              String?
  /// Kitchen promise given when the order was accepted (placedAt + prepMinutes).
  promisedReadyAt           DateTime?
  /// PLACED orders: placedAt + the restaurant's acceptTimeoutMinutes; the watchdog alarms past it (docs/SIPARIS_VE_SEVK.md).
  acceptDeadlineAt          DateTime?
  /// Set once the overdue alarm went out, so it goes out once.
  acceptAlertSentAt         DateTime?
  /// Latest delivery estimate, recomputed from the courier's position while on the way.
  estimatedDeliveryAt       DateTime?
  placedAt                  DateTime  @default(now())
  /// A scheduled order's slot (docs/ILERI_TARIHLI_SIPARIS.md): ready for pickup, or arriving for delivery; null for as soon as possible.
  scheduledFor              DateTime?
  acceptedAt                DateTime?
  readyAt                   DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  /// OWN_POS commission bookkeeping (docs/MUTABAKAT.md, "İade ve chargeback"): the invoice that billed the order and
  /// when its whole commission was cancelled (fully refunded or charged back after completion). Credits are per refund
  /// (OrderRefund.creditInvoiceId); commissionCreditInvoiceId is no longer written and goes in a later release.
  commissionInvoiceId       String?
  commissionReversedAt      DateTime?
  commissionCreditInvoiceId String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  customer            User?                @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  table               DiningTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  ledgerEntries       LedgerEntry[]
  loyaltyTransactions LoyaltyTransaction[]
  couponRedemption    CouponRedemption?
  referralReward      ReferralReward?
  feedbackCase        FeedbackCase?
  npsResponse         NpsResponse?
  posSync             PosOrderSync?
  rating              OrderRating?
  deliveryRequest     DeliveryRequest?
  deliveryStops       DeliveryStop[]
  refunds             OrderRefund[]
  claims              OrderClaim[]

  campaignConversion CampaignRecipient?
  journeyRuns        JourneyRun[]       @relation("JourneyRunOrder")
  journeyConversion  JourneyRun?        @relation("JourneyRunConversion")

  @@index([restaurantId, placedAt])
  @@index([restaurantId, scheduledFor])
  @@index([restaurantId, status])
  @@index([status, acceptDeadlineAt])
  @@index([customerUserId])
  @@index([restaurantId, commissionInvoiceId])
  @@index([restaurantId, commissionCreditInvoiceId])
  @@map("orders")
}

model OrderItem {
  id                String    @id @default(uuid())
  orderId           String
  menuItemId        String?
  nameSnapshot      String
  unitPriceMinor    Int
  quantity          Int
  vatRateBps        Int
  /// Chosen modifiers as [{ name, priceDeltaMinor }].
  modifiersSnapshot Json?
  lineTotalMinor    Int
  /// Position in the basket, so receipts and screens list items as the customer entered them.
  position          Int       @default(0)
  /// When the kitchen marked the line done on the kitchen display (docs/MUTFAK_EKRANI.md).
  preparedAt        DateTime?
  /// Portions this line took from the item's stock (docs/STOK.md); given back once if the order is cancelled.
  stockTaken        Int       @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  reason      String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                   String        @id @default(uuid())
  restaurantId         String
  orderId              String
  provider             String
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amountMinor          Int
  currency             String
  /// The PSP's own fee as reported in its settlement, when known.
  pspFeeMinor          Int?
  providerRef          String?
  capturedAt           DateTime?
  refundedMinor        Int           @default(0)
  /// Which merchant collected: the restaurant's own POS or the platform's PSP, as it was at payment time.
  paymentMode          PaymentMode   @default(OWN_POS)
  /// The stored card used, when the customer paid with a saved card.
  savedPaymentMethodId String?
  /// Staff member or courier who recorded a collection at the door or the counter.
  collectedByUserId    String?
  /// A refund attempt holds this claim while its gateway call is in flight (docs/ODEME.md, "İade").
  refundRequestedAt    DateTime?
  refundLastAttemptAt  DateTime?
  refundAttempts       Int           @default(0)
  /// Machine code of the last failed refund attempt; cleared when a refund succeeds.
  refundFailureCode    String?
  refundedAt           DateTime?
  refundProviderRef    String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  savedPaymentMethod SavedPaymentMethod? @relation(fields: [savedPaymentMethodId], references: [id], onDelete: SetNull)
  collectedBy        User?               @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id], onDelete: SetNull)
  refunds            OrderRefund[]

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([providerRef])
  @@index([status, refundFailureCode])
  @@map("payments")
}

/// One refund of one payment (docs/ODEME.md "İade", docs/MUTABAKAT.md "Kısmi iade"): what went back to the customer,
/// why, and the share of the order's commission the platform gave back with it. Written in the same transaction as
/// the payment's refunded amount, so the rows of an order add up to what its payments gave back.
model OrderRefund {
  id                 String            @id @default(uuid())
  restaurantId       String
  orderId            String
  paymentId          String?
  source             OrderRefundSource
  amountMinor        Int
  currency           String
  /// Commission and VAT given back with this refund; 0 for an order that never completed.
  commissionMinor    Int               @default(0)
  commissionVatMinor Int               @default(0)
  /// Items given back, [{ orderItemId, quantity }], when the refund was for items.
  items              Json?
  reason             String?
  createdByUserId    String?
  /// The customer's missing-item claim this refund paid out, when it came from one.
  claimId            String?
  /// OWN_POS: the commission invoice that credited this refund's commission back.
  creditInvoiceId    String?
  createdAt          DateTime          @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("OrderRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  claim      OrderClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([restaurantId, creditInvoiceId])
  @@map("order_refunds")
}

/// A customer's report that items did not arrive (docs/ODEME.md, "Eksik ürün bildirimi"). The restaurant approves
/// (all or part of it), which pays it out as a partial refund (OrderRefund.claimId), or declines with a reason.
model OrderClaim {
  id              String           @id @default(uuid())
  restaurantId    String
  orderId         String
  status          OrderClaimStatus @default(OPEN)
  /// Claimed items, [{ orderItemId, quantity }].
  items           Json
  /// What the claimed items were worth at what the customer paid, when filed.
  requestedMinor  Int
  note            String?
  decidedByUserId String?
  decidedAt       DateTime?
  declineReason   String?
  /// Set when an undecided claim moved to the platform console (claim_escalation module).
  escalatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  decidedBy  User?         @relation("OrderClaimDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  refunds    OrderRefund[]

  @@index([orderId, createdAt])
  @@index([restaurantId, status])
  @@index([status, createdAt])
  @@map("order_claims")
}

/// A restaurant's own virtual POS (docs/ODEME.md). Credentials are encrypted
/// with the platform key (AES-256-GCM; envelope encryption with a KMS in
/// production) and never leave the API.
model PaymentProviderConnection {
  id                   String                  @id @default(uuid())
  restaurantId         String                  @unique
  providerCode         String
  encryptedCredentials String
  /// Identifies the key that encrypted the credentials, so keys can be rotated.
  keyVersion           String
  status               PaymentConnectionStatus @default(PENDING_VERIFICATION)
  /// Masked identification shown in the panel, e.g. "PAYTR ****1234".
  label                String
  lastVerifiedAt       DateTime?
  failureReason        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_provider_connections")
}

/// A customer's card as held by a vault provider; only the provider's token is stored, encrypted.
/// How a restaurant accepts one meal card issuer (docs/YEMEK_KARTI.md): at
/// the door, online with the issuer's API credentials (encrypted, verified),
/// or both. The restaurant is the issuer's member merchant, never the platform.
model MealCardConnection {
  id                   String                  @id @default(uuid())
  restaurantId         String
  providerCode         String
  acceptsOnline        Boolean                 @default(false)
  acceptsOnDelivery    Boolean                 @default(true)
  encryptedCredentials String?
  keyVersion           String?
  status               PaymentConnectionStatus @default(DISABLED)
  label                String?
  lastVerifiedAt       DateTime?
  failureReason        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, providerCode])
  @@map("meal_card_connections")
}

model SavedPaymentMethod {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  /// The vault's token, encrypted at rest. Never a card number.
  encryptedToken String
  keyVersion     String
  tokenHash      String
  brand          String
  last4          String
  expiryMonth    Int
  expiryYear     Int
  label          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  billingRestaurants Restaurant[] @relation("RestaurantBillingCard")

  @@unique([userId, provider, tokenHash])
  @@index([userId])
  @@map("saved_payment_methods")
}

/// Monthly commission invoice of an OWN_POS restaurant: the commission and
/// VAT snapshotted on each paid order of the month, collected afterwards.
model CommissionInvoice {
  id                  String                  @id @default(uuid())
  restaurantId        String
  periodStart         DateTime
  periodEnd           DateTime
  currency            String
  orderCount          Int
  baseMinor           Int
  commissionMinor     Int
  vatMinor            Int
  totalMinor          Int
  status              CommissionInvoiceStatus @default(DRAFT)
  issuedAt            DateTime?
  dueAt               DateTime?
  paidAt              DateTime?
  /// Reference of the collection (card charge or bank transfer).
  paymentRef          String?
  /// The saved card the collection used, when it was a card.
  paymentMethodId     String?
  /// Fiscal document (e-Arsiv or the regional equivalent) issued by the invoice provider adapter.
  fiscalRef           String?
  fiscalDocumentUrl   String?
  /// Automatic collection bookkeeping (docs/FATURALAMA.md): attempts, the last one and why it failed.
  collectionAttempts  Int                     @default(0)
  lastCollectionAt    DateTime?
  lastCollectionError String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([restaurantId, periodStart])
  @@index([restaurantId, status])
  @@index([status, dueAt])
  @@map("commission_invoices")
}

/// Append-only. Amounts are signed from the restaurant's point of view.
model LedgerEntry {
  id           String          @id @default(uuid())
  restaurantId String
  orderId      String?
  payoutId     String?
  invoiceId    String?
  type         LedgerEntryType
  amountMinor  Int
  currency     String
  occurredAt   DateTime        @default(now())
  memo         String?

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payout     Payout?            @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  invoice    CommissionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([restaurantId, occurredAt])
  @@index([orderId])
  @@index([payoutId])
  @@index([invoiceId])
  @@map("ledger_entries")
}

/// A transfer of accumulated restaurant payables. Scheduled within the legal payment deadline of the region.
model Payout {
  id            String       @id @default(uuid())
  restaurantId  String
  periodStart   DateTime
  periodEnd     DateTime
  amountMinor   Int
  currency      String
  status        PayoutStatus @default(SCHEDULED)
  scheduledFor  DateTime
  sentAt        DateTime?
  settledAt     DateTime?
  providerRef   String?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([restaurantId, scheduledFor])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Plans and message credits (docs/FIYATLANDIRMA.md)
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(uuid())
  /// BASIC or PRO (PLAN_CODES in shared); prices are data, the vocabulary is code.
  code              String   @unique
  name              String
  monthlyPriceMinor Int
  currency          String
  isFree            Boolean  @default(false)
  trialDays         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions RestaurantSubscription[]

  @@map("plans")
}

model RestaurantSubscription {
  id               String             @id @default(uuid())
  restaurantId     String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@map("restaurant_subscriptions")
}

model MessageCreditPackage {
  id         String         @id @default(uuid())
  code       String         @unique
  channel    MessageChannel
  credits    Int
  priceMinor Int
  currency   String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@map("message_credit_packages")
}

model MessageWallet {
  id           String         @id @default(uuid())
  restaurantId String
  channel      MessageChannel
  balance      Int            @default(0)
  updatedAt    DateTime       @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions MessageTransaction[]

  @@unique([restaurantId, channel])
  @@map("message_wallets")
}

model MessageTransaction {
  id           String                 @id @default(uuid())
  walletId     String
  type         MessageTransactionType
  delta        Int
  balanceAfter Int
  /// Package code, message log id or an admin note.
  reference    String?
  createdAt    DateTime               @default(now())

  wallet MessageWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("message_transactions")
}

/// One attempted message. Credits are debited only when status reaches SENT.
enum PushPlatform {
  IOS
  ANDROID
}

/// A phone that receives notifications for a person (docs/MESAJLASMA.md, push). Belongs to the user, not to a restaurant.
model PushDevice {
  id         String       @id @default(uuid())
  userId     String
  platform   PushPlatform
  /// Expo push token; unique, so a token that moves to another account follows it.
  token      String       @unique
  appVersion String?
  locale     String?
  lastSeenAt DateTime     @default(now())
  /// Set when the push service reported the device gone; cleared when the app registers again.
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model MessageLog {
  id             String         @id @default(uuid())
  restaurantId   String?
  channel        MessageChannel
  /// Masked for display; the full number is never logged.
  toMasked       String
  templateKey    String
  status         MessageStatus  @default(PENDING)
  provider       String
  providerRef    String?
  creditsCharged Int            @default(0)
  errorCode      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("message_logs")
}

// ---------------------------------------------------------------------------
// Courier networks (docs/KURYE.md)
// ---------------------------------------------------------------------------

model CourierProvider {
  id          String   @id @default(uuid())
  /// Adapter key registered in the API (MOCK in development).
  code        String   @unique
  name        String
  countryCode String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  restaurants      Restaurant[]
  deliveryRequests DeliveryRequest[]

  @@map("courier_providers")
}

model DeliveryRequest {
  id                String                @id @default(uuid())
  restaurantId      String
  orderId           String                @unique
  providerId        String
  status            DeliveryRequestStatus @default(QUOTED)
  quoteId           String?
  quoteFeeMinor     Int
  finalFeeMinor     Int?
  currency          String
  providerRef       String?
  trackingUrl       String?
  pickupEtaMinutes  Int?
  dropoffEtaMinutes Int?
  failureReason     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   CourierProvider @relation(fields: [providerId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([providerRef])
  @@map("delivery_requests")
}

// ---------------------------------------------------------------------------
// Compliance and platform
// ---------------------------------------------------------------------------

/// A courier's run from the restaurant with one or more orders. Owned by the
/// restaurant; the courier is a membership with the courier.deliver permission.
model DeliveryTrip {
  id                     String             @id @default(uuid())
  restaurantId           String
  branchId               String
  courierMembershipId    String?
  createdByUserId        String?
  status                 DeliveryTripStatus @default(PLANNED)
  sequenceMode           StopSequenceMode   @default(MANUAL)
  /// Planned road distance and travel time over all stops, from the routing adapter.
  plannedDistanceMeters  Int?
  plannedDurationSeconds Int?
  assignedAt             DateTime?
  pickedUpAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch          Branch                  @relation(fields: [branchId], references: [id])
  courier         Membership?             @relation(fields: [courierMembershipId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  stops           DeliveryStop[]
  locationSamples CourierLocationSample[]

  @@index([restaurantId, status])
  @@index([courierMembershipId, status])
  @@map("delivery_trips")
}

/// One order inside a trip, in delivery sequence. An order can appear in
/// several trips over its life (a failed delivery is re-dispatched) but in at
/// most one active trip, which the service enforces.
model DeliveryStop {
  id             String             @id @default(uuid())
  tripId         String
  restaurantId   String
  orderId        String
  sequence       Int
  status         DeliveryStopStatus @default(PENDING)
  /// Destination snapshot copied from the order address at the time the stop was added.
  lat            Float?
  lng            Float?
  /// Latest estimate for this stop: cumulative road distance and arrival time.
  distanceMeters Int?
  etaAt          DateTime?
  arrivedAt      DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  /// How the delivery was confirmed while delivery_pin is on: PIN (the customer's code) or STAFF (dispatcher, without the code).
  proof          String?
  /// Wrong codes tried by the courier; at the limit only staff can deliver the stop.
  codeAttempts   Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  trip       DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tripId, sequence])
  @@index([orderId, status])
  @@map("delivery_stops")
}

/// Latest known position of a courier, one row per membership, overwritten on
/// every ping. Only accepted while the courier has an active trip.
model CourierLocation {
  membershipId String   @id
  restaurantId String
  tripId       String?
  lat          Float
  lng          Float
  headingDeg   Float?
  speedMps     Float?
  accuracyM    Float?
  recordedAt   DateTime
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("courier_locations")
}

/// Downsampled trail of a trip (for disputes and the trip replay); append-only.
model CourierLocationSample {
  id           String   @id @default(uuid())
  tripId       String
  membershipId String
  lat          Float
  lng          Float
  recordedAt   DateTime
  createdAt    DateTime @default(now())

  trip       DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  membership Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("courier_location_samples")
}

model DocumentVersion {
  id          String       @id @default(uuid())
  type        DocumentType
  version     String
  locale      String
  body        String
  publishedAt DateTime     @default(now())

  consents Consent[]

  @@unique([type, version, locale])
  @@map("document_versions")
}

model Consent {
  id                String   @id @default(uuid())
  userId            String
  documentVersionId String
  acceptedAt        DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@index([userId])
  @@map("consents")
}

model FeatureFlag {
  id           String           @id @default(uuid())
  key          String
  scope        FeatureFlagScope
  restaurantId String?
  enabled      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([key, scope, restaurantId])
  @@map("feature_flags")
}

model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String?
  actorUserId  String?
  action       String
  entity       String
  entityId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A restaurant-funded discount code (docs/KUPONLAR.md). Rules are fixed once created; only isActive changes.
model Coupon {
  id                 String    @id @default(uuid())
  restaurantId       String
  /// Upper case, unique per restaurant.
  code               String
  /// PERCENT or AMOUNT (COUPON_KINDS in shared).
  kind               String
  percentBps         Int?
  maxDiscountMinor   Int?
  amountMinor        Int?
  minBasketMinor     Int       @default(0)
  firstOrderOnly     Boolean   @default(false)
  perCustomerLimit   Int       @default(1)
  maxRedemptions     Int?
  /// Uses that still count; raised atomically with the order, lowered when the order is cancelled.
  redemptionCount    Int       @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean   @default(true)
  /// MANUAL, REFERRAL (a customer's personal code) or REFERRAL_REWARD (COUPON_SOURCES in shared, docs/TAVSIYE.md).
  source             String    @default("MANUAL")
  /// REFERRAL: the customer who shares this code; one personal code per customer.
  referrerCustomerId String?   @unique
  /// REFERRAL_REWARD: the only customer who may use it.
  ownerCustomerId    String?
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  referrer    RestaurantCustomer? @relation("ReferralCode", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  owner       RestaurantCustomer? @relation("RewardCoupon", fields: [ownerCustomerId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]
  reward      ReferralReward?

  @@unique([restaurantId, code])
  @@index([restaurantId, source])
  @@index([ownerCustomerId])
  @@map("coupons")
}

/// One order's use of a coupon; releasedAt is set when the order is cancelled and the use given back.
model CouponRedemption {
  id            String    @id @default(uuid())
  restaurantId  String
  couponId      String
  orderId       String    @unique
  customerId    String
  discountMinor Int
  currency      String
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coupon     Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([couponId, customerId])
  @@index([restaurantId, createdAt])
  @@map("coupon_redemptions")
}

enum PosConnectionStatus {
  ACTIVE
  FAILED
}

enum PosSyncStatus {
  PENDING
  SENT
  FAILED
}

/// The restaurant's own point of sale (docs/POS_ENTEGRASYONU.md); credentials encrypted like the POS payment connection.
model PosConnection {
  id                   String              @id @default(uuid())
  restaurantId         String              @unique
  providerCode         String
  encryptedCredentials String
  keyVersion           String
  label                String
  status               PosConnectionStatus
  failureReason        String?
  /// Accept a new order as soon as the POS has it, with defaultPrepMinutes.
  autoAccept           Boolean             @default(false)
  defaultPrepMinutes   Int                 @default(20)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  syncs      PosOrderSync[]

  @@map("pos_connections")
}

/// One order's delivery to the POS: pushed once, retried with backoff until POS_MAX_ATTEMPTS.
model PosOrderSync {
  id            String        @id @default(uuid())
  restaurantId  String
  connectionId  String
  orderId       String        @unique
  status        PosSyncStatus @default(PENDING)
  externalRef   String?
  attempts      Int           @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  connection PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([connectionId, externalRef])
  @@map("pos_order_syncs")
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum ContactActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE_CHANGE
  TASK_DONE
  FORM
  CONVERSION
}

/// A step of the tenant's pipeline (docs/CRM.md); defaults are created on first use, names are tenant data.
model PipelineStage {
  id           String    @id @default(uuid())
  restaurantId String
  /// Key of a default stage (labels crm.stage.<key>) or null for a custom one.
  key          String?
  name         String?
  kind         StageKind @default(OPEN)
  position     Int
  createdAt    DateTime  @default(now())

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  contacts   RestaurantCustomer[]

  @@unique([restaurantId, key])
  @@index([restaurantId, position])
  @@map("pipeline_stages")
}

/// Append-only history of a contact: notes, calls, meetings, emails, stage changes, finished tasks.
model ContactActivity {
  id           String              @id @default(uuid())
  restaurantId String
  customerId   String
  type         ContactActivityType
  body         String?
  actorUserId  String?
  createdAt    DateTime            @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor      User?              @relation("ContactActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("contact_activities")
}

/// A follow-up on a contact, optionally assigned to a member and due at a time.
model ContactTask {
  id                   String    @id @default(uuid())
  restaurantId         String
  customerId           String
  title                String
  dueAt                DateTime?
  assigneeMembershipId String?
  doneAt               DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee   Membership?        @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)

  @@index([restaurantId, doneAt, dueAt])
  @@index([customerId])
  @@map("contact_tasks")
}

// ---------------------------------------------------------------------------
// Attribution (docs/ATIF.md)
// ---------------------------------------------------------------------------

/// An anonymous browser that allowed measurement; id is the rg_vid cookie. Linked to a contact once it orders or signs up.
model Visitor {
  restaurantId String
  id           String
  customerId   String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer    RestaurantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  touchpoints Touchpoint[]

  @@id([restaurantId, id])
  @@index([customerId])
  @@map("visitors")
}

/// Where one visit came from. Host and path only (no query string), referrer host only, no IP address; click ids only with advertising consent.
model Touchpoint {
  id                 String   @id @default(uuid())
  restaurantId       String
  visitorId          String
  sessionId          String
  occurredAt         DateTime @default(now())
  landingHost        String
  landingPath        String
  referrerHost       String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  utmId              String?
  campaignId         String?
  adsetId            String?
  adId               String?
  refCode            String?
  adPlatform         String?
  clickIds           Json?
  advertisingConsent Boolean  @default(false)
  untaggedPaid       Boolean  @default(false)
  locale             String?
  countryCode        String?
  deviceType         String?
  tableId            String?
  customerId         String?

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visitor     Visitor             @relation(fields: [restaurantId, visitorId], references: [restaurantId, id], onDelete: Cascade)
  table       DiningTable?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer    RestaurantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversions ConversionEvent[]

  @@index([restaurantId, occurredAt])
  @@index([restaurantId, visitorId, occurredAt])
  @@index([customerId, occurredAt])
  @@map("touchpoints")
}

/// A business result credited to touchpoints; (restaurantId, sourceKind, sourceId) makes recording idempotent.
model ConversionEvent {
  id                     String   @id @default(uuid())
  restaurantId           String
  type                   String
  occurredAt             DateTime @default(now())
  customerId             String?
  valueMinor             Int?
  currency               String?
  sourceKind             String
  sourceId               String
  /// Last touch within the window at the time of recording, for the contact card and ad platform feedback.
  attributedTouchpointId String?
  createdAt              DateTime @default(now())

  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer             RestaurantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attributedTouchpoint Touchpoint?         @relation(fields: [attributedTouchpointId], references: [id], onDelete: SetNull)

  adDeliveries AdConversionDelivery[]

  @@unique([restaurantId, sourceKind, sourceId])
  @@index([restaurantId, occurredAt])
  @@index([customerId])
  @@map("conversion_events")
}

// ---------------------------------------------------------------------------
// Commercial message consent (docs/RIZA.md)
// ---------------------------------------------------------------------------

/// One decision on one channel; append-only, the latest row per channel is the state.
model ContactConsent {
  id                      String    @id @default(uuid())
  restaurantId            String
  customerId              String
  channel                 String
  granted                 Boolean
  legalBasis              String    @default("CONSENT")
  source                  String
  note                    String?
  formVersion             String?
  /// Set when the consent waits for its confirmation link (double opt-in); it counts only once confirmedAt is set.
  confirmationRequestedAt DateTime?
  confirmedAt             DateTime?
  /// When the decision reached the regional registry (IYS); null until then, never for uncovered channels.
  registrySyncedAt        DateTime?
  actorUserId             String?
  createdAt               DateTime  @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channel, createdAt])
  @@index([restaurantId, registrySyncedAt])
  @@map("contact_consents")
}

/// A double opt-in link; only the SHA-256 of the token is stored.
model ConsentConfirmation {
  id           String    @id @default(uuid())
  restaurantId String
  customerId   String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("consent_confirmations")
}

/// A tenant's commercial message policy; without a row the defaults apply (DEFAULT_CONSENT_POLICY).
model MarketingSettings {
  restaurantId       String   @id
  dailyCap           Int      @default(1)
  weeklyCap          Int      @default(3)
  doubleOptInRegions String[] @default(["EU_UK"])
  merchantExemption  Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("marketing_settings")
}

// ---------------------------------------------------------------------------
// Email channel (docs/EPOSTA.md)
// ---------------------------------------------------------------------------

/// A tenant's sending domain; verified once SPF, DKIM and DMARC are published. A domain belongs to one tenant.
model EmailDomain {
  id            String    @id @default(uuid())
  restaurantId  String
  domain        String    @unique
  fromLocalPart String
  fromName      String
  dkimTokens    String[]  @default([])
  status        String    @default("PENDING")
  spfStatus     String    @default("PENDING")
  dkimStatus    String    @default("PENDING")
  dmarcStatus   String    @default("PENDING")
  dmarcPolicy   String?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("email_domains")
}

/// An address that must not be mailed: a hard bounce for everyone (restaurantId null), a complaint or unsubscribe for one sender.
model EmailSuppression {
  id           String   @id @default(uuid())
  restaurantId String?
  email        String
  reason       String
  /// The provider's message or feedback id, for tracing.
  detail       String?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([restaurantId])
  @@map("email_suppressions")
}

// ---------------------------------------------------------------------------
// Segments v2 (docs/SEGMENTLER.md)
// ---------------------------------------------------------------------------

/// A saved audience: a rule tree evaluated on use (DYNAMIC) or a snapshot of who matched (STATIC).
model Segment {
  id              String    @id @default(uuid())
  restaurantId    String
  name            String
  kind            String
  /// SegmentRuleSchema in shared.
  rule            Json
  memberCount     Int       @default(0)
  snapshotAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    SegmentMember[]
  campaigns  Campaign[]
  journeys   Journey[]

  @@unique([restaurantId, name])
  @@map("segments")
}

/// A member of a static segment, taken when the snapshot was made.
model SegmentMember {
  segmentId  String
  customerId String

  segment  Segment            @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([segmentId, customerId])
  @@index([customerId])
  @@map("segment_members")
}

// ---------------------------------------------------------------------------
// Automated flows (docs/AKISLAR.md)
// ---------------------------------------------------------------------------

/// One automated message: a trigger (JOURNEY_TRIGGERS in shared) sends it to one customer after a delay.
model Journey {
  id              String         @id @default(uuid())
  restaurantId    String
  name            String
  trigger         String
  channel         MessageChannel
  subject         String?
  body            String
  delayHours      Int            @default(0)
  /// WIN_BACK only: days without an order.
  inactiveDays    Int?
  cooldownDays    Int            @default(30)
  attributionDays Int            @default(3)
  segmentId       String?
  /// ACTIVE or PAUSED; a new flow starts paused.
  status          String         @default("PAUSED")
  lastError       String?
  /// WIN_BACK: when the audience was last scanned.
  lastScanAt      DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  segmentRef Segment?     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  runs       JourneyRun[]

  @@index([restaurantId, createdAt])
  @@index([status, trigger])
  @@map("journeys")
}

/// One customer in one flow: due at a moment, then sent, skipped, failed or cancelled; credited like a campaign message.
model JourneyRun {
  id               String    @id @default(uuid())
  journeyId        String
  customerId       String
  /// The order that triggered it (order triggers); one run per flow and order.
  orderId          String?
  dueAt            DateTime
  status           String    @default("PENDING")
  errorCode        String?
  messageLogId     String?
  sentAt           DateTime?
  convertedOrderId String?   @unique
  convertedAt      DateTime?
  revenueMinor     Int?
  createdAt        DateTime  @default(now())

  journey        Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customer       RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order          Order?             @relation("JourneyRunOrder", fields: [orderId], references: [id], onDelete: SetNull)
  convertedOrder Order?             @relation("JourneyRunConversion", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@unique([journeyId, orderId])
  @@index([status, dueAt])
  @@index([journeyId, customerId, createdAt])
  @@index([customerId, sentAt])
  @@map("journey_runs")
}

// ---------------------------------------------------------------------------
// Ad platform integrations (docs/REKLAM.md)
// ---------------------------------------------------------------------------

/// A tenant's ad account on one platform; credentials encrypted with CredentialCipher, never returned.
model AdConnection {
  id                   String    @id @default(uuid())
  restaurantId         String
  platform             String
  /// ACTIVE, PAUSED or ERROR (the last check or delivery found the credentials refused).
  status               String    @default("ACTIVE")
  encryptedCredentials String
  keyVersion           String
  /// Non-secret fields (pixel id, customer id) for display and requests.
  publicConfig         Json
  sendTypes            String[]
  enhancedMatching     Boolean   @default(false)
  lastSentAt           DateTime?
  lastSpendSyncAt      DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveries AdConversionDelivery[]
  spend      AdSpendDaily[]

  @@unique([restaurantId, platform])
  @@map("ad_connections")
}

/// One conversion to one ad platform: queued, retried with backoff, then sent, skipped or failed.
model AdConversionDelivery {
  id                String    @id @default(uuid())
  connectionId      String
  conversionEventId String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  errorCode         String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  connection AdConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversion ConversionEvent @relation(fields: [conversionEventId], references: [id], onDelete: Cascade)

  @@unique([connectionId, conversionEventId])
  @@index([status, nextAttemptAt])
  @@map("ad_conversion_deliveries")
}

/// Daily spend of one platform campaign, as the platform reports it, in minor units of its currency.
model AdSpendDaily {
  id           String   @id @default(uuid())
  connectionId String
  restaurantId String
  date         DateTime @db.Date
  campaignRef  String
  campaignName String?
  spendMinor   Int
  currency     String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  updatedAt    DateTime @updatedAt

  connection AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date, campaignRef])
  @@index([restaurantId, date])
  @@map("ad_spend_daily")
}

/// A page of the platform's own site built from blocks (docs/SAYFA_MOTORU.md); served at /p/<locale>/<path>.
model SitePage {
  id             String    @id @default(uuid())
  restaurantId   String
  path           String
  locale         String
  title          String
  description    String
  /// SiteBlock[] (shared site.ts); plain text only.
  blocks         Json
  /// Pages sharing this key are translations of each other (hreflang).
  translationKey String?
  /// DRAFT or PUBLISHED.
  status         String    @default("DRAFT")
  /// PAGE (served at /p/<locale>/<path>) or POST (a blog post at /blog/<locale>/<path>, docs/BLOG.md).
  kind           String    @default("PAGE")
  /// Byline of a post; the platform's name when null.
  authorName     String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, locale, path])
  @@index([restaurantId, translationKey])
  @@index([restaurantId, kind, status, publishedAt])
  @@map("site_pages")
}

/// A restaurant's customer referral programme (docs/TAVSIYE.md): the friend's first-order discount and the referrer's reward.
model ReferralProgram {
  id                     String   @id @default(uuid())
  restaurantId           String   @unique
  isActive               Boolean  @default(false)
  /// PERCENT or AMOUNT; personal codes copy these terms.
  friendKind             String
  friendPercentBps       Int?
  friendMaxDiscountMinor Int?
  friendAmountMinor      Int?
  friendMinBasketMinor   Int      @default(0)
  rewardAmountMinor      Int
  rewardValidDays        Int      @default(90)
  monthlyCapPerReferrer  Int      @default(10)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("referral_programs")
}

/// A friend's completed first order with a personal code, and what the referrer got for it.
model ReferralReward {
  id                 String   @id @default(uuid())
  restaurantId       String
  referrerCustomerId String
  friendCustomerId   String
  orderId            String   @unique
  /// GRANTED or SKIPPED_CAP (REFERRAL_REWARD_STATUSES in shared).
  status             String
  rewardCouponId     String?  @unique
  valueMinor         Int      @default(0)
  currency           String
  createdAt          DateTime @default(now())

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  referrer     RestaurantCustomer @relation("Referrer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  friend       RestaurantCustomer @relation("ReferredFriend", fields: [friendCustomerId], references: [id], onDelete: Cascade)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rewardCoupon Coupon?            @relation(fields: [rewardCouponId], references: [id], onDelete: SetNull)

  @@index([referrerCustomerId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("referral_rewards")
}

/// Platform settings of restaurant-to-restaurant referrals (docs/RESTORAN_TAVSIYE.md); a single row with id "default".
model PartnerReferralConfig {
  id                   String   @id @default("default")
  isActive             Boolean  @default(false)
  referrerRewardDays   Int      @default(30)
  refereeBonusDays     Int      @default(30)
  qualifyingOrders     Int      @default(10)
  yearlyCapPerReferrer Int      @default(12)
  updatedByUserId      String?
  updatedAt            DateTime @updatedAt

  @@map("partner_referral_config")
}

/// A restaurant that signed up with another restaurant's partner code, and what each side got.
model PartnerReferral {
  id                   String    @id @default(uuid())
  referrerRestaurantId String
  refereeRestaurantId  String    @unique
  code                 String
  /// PENDING, REWARDED or CAPPED (PARTNER_REFERRAL_STATUSES in shared).
  status               String    @default("PENDING")
  refereeBonusDays     Int       @default(0)
  rewardDays           Int?
  rewardedAt           DateTime?
  createdAt            DateTime  @default(now())

  referrer Restaurant @relation("PartnerReferrer", fields: [referrerRestaurantId], references: [id], onDelete: Cascade)
  referee  Restaurant @relation("PartnerReferee", fields: [refereeRestaurantId], references: [id], onDelete: Cascade)

  @@index([referrerRestaurantId, createdAt])
  @@index([status])
  @@map("partner_referrals")
}

/// A restaurant's feedback routing (docs/GERI_BILDIRIM.md): its public review page, the low-rating threshold and NPS.
model FeedbackSettings {
  id            String   @id @default(uuid())
  restaurantId  String   @unique
  reviewUrl     String?
  alertMaxScore Int      @default(2)
  npsEnabled    Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("feedback_settings")
}

/// A low rating the staff follow up on; one per order.
model FeedbackCase {
  id               String    @id @default(uuid())
  restaurantId     String
  orderId          String    @unique
  score            Int
  comment          String?
  /// OPEN or RESOLVED (FEEDBACK_CASE_STATUSES in shared).
  status           String    @default("OPEN")
  note             String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
  @@map("feedback_cases")
}

/// The NPS answer of one order's customer (0 to 10), from the tracking page.
model NpsResponse {
  id           String   @id @default(uuid())
  restaurantId String
  orderId      String   @unique
  score        Int
  comment      String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("nps_responses")
}
