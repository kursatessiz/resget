// Multi-tenant schema of the restaurant ordering network. Every tenant-scoped
// table carries restaurant_id and every query filters by it (CLAUDE.md).
// Anything a restaurant configures (menu, tables, fee policies, service
// areas, plans, credit packages) is data, never an enum; enums below are
// lifecycle states only.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum MembershipStatus {
  INVITED
  ACTIVE
  PASSIVE
}

enum InviteChannel {
  SHOWN
  WHATSAPP
  SMS
}

enum OtpPurpose {
  LOGIN
  INVITE
}

enum OrderChannel {
  TABLE_QR
  RESTAURANT_SITE
  MARKETPLACE
  PHONE
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum DeliveryMode {
  RESTAURANT_COURIER
  THIRD_PARTY_API
  NONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  READY
  HANDED_TO_COURIER
  OUT_FOR_DELIVERY
  ARRIVING
  DELIVERED
  PICKED_UP
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_RESTAURANT
  REJECTED
  REFUNDED
}

/// One courier leaving the restaurant with one or more orders (docs/SIPARIS_VE_SEVK.md).
enum DeliveryTripStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  EN_ROUTE
  ARRIVING
  DELIVERED
  FAILED
  REMOVED
}

enum StopSequenceMode {
  MANUAL
  OPTIMIZED
}

enum PaymentMode {
  OWN_POS
  PLATFORM_PSP
}

enum PaymentConnectionStatus {
  PENDING_VERIFICATION
  ACTIVE
  FAILED
  DISABLED
}

enum CommissionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  ONLINE_CARD
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  MEAL_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LedgerEntryType {
  GROSS_SALE
  DISCOUNT
  DELIVERY_FEE
  COURIER_COST
  PLATFORM_COMMISSION
  COMMISSION_VAT
  PSP_FEE
  WITHHOLDING_TAX
  REFUND
  ADJUSTMENT
  RESTAURANT_PAYABLE
}

enum LoyaltyTransactionType {
  EARN
  WELCOME
  REDEEM
  REVERSAL
  ADJUSTMENT
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutStatus {
  SCHEDULED
  SENT
  SETTLED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MessageChannel {
  SMS
  WHATSAPP
  PUSH
  EMAIL
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

/// Marketing campaign lifecycle (docs/KAMPANYALAR.md).
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MessageTransactionType {
  PURCHASE
  GRANT
  DEBIT
  REFUND
  EXPIRY
}

enum DeliveryRequestStatus {
  QUOTED
  REQUESTED
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

enum QrScanOutcome {
  VIEWED_MENU
  STARTED_ORDER
  PLACED_ORDER
  REGISTERED
}

enum FeatureFlagScope {
  GLOBAL
  RESTAURANT
}

enum DocumentType {
  TERMS_OF_SERVICE
  PRIVACY_NOTICE
  RESTAURANT_AGREEMENT
  MARKETING_CONSENT
}

// ---------------------------------------------------------------------------
// Identity: users are global and identified by phone; a Membership links a
// user to a restaurant with a role. Customers are users too (a guest who
// registers from a table QR becomes a User with no Membership).
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  /// E.164
  phone        String   @unique
  fullName     String
  email        String?
  locale       String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         Membership[]
  addresses           CustomerAddress[]
  orders              Order[]
  consents            Consent[]
  restaurantCustomers RestaurantCustomer[]
  otpCodes            OtpCode[]
  savedPaymentMethods SavedPaymentMethod[]
  invitesCreated      InviteToken[]        @relation("InviteCreatedBy")
  statusChanges       OrderStatusHistory[]
  tripsCreated        DeliveryTrip[]
  paymentsCollected   Payment[]            @relation("PaymentCollectedBy")
  auditLogs           AuditLog[]
  campaignsCreated    Campaign[]           @relation("CampaignCreatedBy")
  apiKeysCreated      RestaurantApiKey[]   @relation("ApiKeyCreatedBy")

  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  userId    String?
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// Marketplace visitors asking for a district that is not open yet; one counter per district (docs/PLATFORM_YONETIMI.md).
model MarketplaceInterest {
  id          String   @id @default(uuid())
  countryCode String
  city        String
  district    String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([countryCode, city, district])
  @@map("marketplace_interest")
}

model ServiceArea {
  id           String    @id @default(uuid())
  countryCode  String
  city         String
  district     String
  /// Phase 0 launches one district at a time; restaurants outside a launched area are onboarded but not listed in the marketplace.
  isLaunched   Boolean   @default(false)
  launchedAt   DateTime?
  /// Restaurants with a sellable menu the district should reach before it opens (docs/PLATFORM_YONETIMI.md).
  launchTarget Int       @default(30)
  createdAt    DateTime  @default(now())

  restaurants Restaurant[]

  @@unique([countryCode, city, district])
  @@map("service_areas")
}

model Restaurant {
  id                     String    @id @default(uuid())
  slug                   String    @unique
  name                   String
  legalName              String?
  taxId                  String?
  countryCode            String
  currency               String
  timezone               String
  defaultLocale          String    @default("tr")
  serviceAreaId          String?
  isActive               Boolean   @default(true)
  /// Listed in the consumer marketplace (requires a launched service area and an approved menu).
  isListed               Boolean   @default(false)
  /// Set while an overdue commission invoice keeps the restaurant out of the marketplace; cleared when it is settled.
  listingSuspendedAt     DateTime?
  /// Marketplace listing review (docs/PLATFORM_YONETIMI.md): when the restaurant asked, when the console decided, and why.
  listingRequestedAt     DateTime?
  listingReviewedAt      DateTime?
  listingReviewNote      String?
  /// The saved card commission invoices are collected from (docs/FATURALAMA.md).
  billingPaymentMethodId String?
  /// Own host of the ordering page (docs/VITRIN.md); served only once DNS is verified and the plan allows it.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  /// Running total of customer ratings (docs/VITRIN.md), so the marketplace lists the average without a scan.
  ratingCount            Int       @default(0)
  ratingSum              Int       @default(0)

  /// Platform take rate on gross order value; 100 = 1 percent. Changed only by the super admin.
  commissionBps        Int          @default(100)
  /// Who collects card payments (docs/ODEME.md): the restaurant's own virtual POS (default) or the platform's PSP.
  paymentMode          PaymentMode  @default(OWN_POS)
  /// PLATFORM_PSP only: the provider's contracted fee for this restaurant, passed through at cost (docs/MUTABAKAT.md).
  pspPercentBps        Int          @default(0)
  pspFixedMinor        Int          @default(0)
  /// How this restaurant moves food by default; per order it can differ.
  deliveryMode         DeliveryMode @default(RESTAURANT_COURIER)
  /// Preferred third-party courier network when deliveryMode is THIRD_PARTY_API.
  courierProviderId    String?
  /// How the quoted courier fee becomes the customer's delivery fee (DeliveryFeePolicySchema in shared).
  deliveryFeePolicy    Json?
  /// Own-courier dispatch tuning (DispatchSettingsSchema in shared): speed, detour, arrival radius, stops per trip.
  dispatchSettings     Json?
  /// Customer notification preferences (NotificationSettingsSchema in shared): order updates on or off, channel, SMS fallback.
  notificationSettings Json?

  logoUrl      String?
  themePrimary String  @default("#0092CD")

  onboardedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceArea          ServiceArea?               @relation(fields: [serviceAreaId], references: [id])
  courierProvider      CourierProvider?           @relation(fields: [courierProviderId], references: [id])
  billingPaymentMethod SavedPaymentMethod?        @relation("RestaurantBillingCard", fields: [billingPaymentMethodId], references: [id], onDelete: SetNull)
  branches             Branch[]
  memberships          Membership[]
  roleTemplates        RoleTemplate[]
  inviteTokens         InviteToken[]
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  tables               DiningTable[]
  qrScanEvents         QrScanEvent[]
  customers            RestaurantCustomer[]
  orders               Order[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  paymentConnection    PaymentProviderConnection?
  mealCardConnections  MealCardConnection[]
  commissionInvoices   CommissionInvoice[]
  subscription         RestaurantSubscription?
  messageWallets       MessageWallet[]
  messageLogs          MessageLog[]
  deliveryRequests     DeliveryRequest[]
  deliveryTrips        DeliveryTrip[]
  deliveryStops        DeliveryStop[]
  courierLocations     CourierLocation[]
  featureFlags         FeatureFlag[]
  auditLogs            AuditLog[]
  campaigns            Campaign[]
  loyaltyProgram       LoyaltyProgram?
  campaignSegments     CampaignSegmentPreset[]
  apiKeys              RestaurantApiKey[]
  webhooks             RestaurantWebhook[]
  orderRatings         OrderRating[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@index([serviceAreaId, isListed])
  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  addressLine  String
  city         String
  district     String
  postalCode   String?
  lat          Float?
  lng          Float?
  phone        String?
  /// Weekly opening hours, per weekday, as { mon: [["09:00","22:00"]], ... }.
  openingHours Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables        DiningTable[]
  orders        Order[]
  deliveryTrips DeliveryTrip[]

  @@index([restaurantId])
  @@map("branches")
}

model RoleTemplate {
  id           String   @id @default(uuid())
  restaurantId String
  /// Key of a default template (owner, manager, counter, kitchen) or null for a custom role.
  templateKey  String?
  name         String
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions RoleTemplatePermission[]
  memberships Membership[]

  @@unique([restaurantId, name])
  @@map("role_templates")
}

model RoleTemplatePermission {
  roleTemplateId String
  permissionKey  String

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionKey])
  @@map("role_template_permissions")
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  restaurantId   String
  roleTemplateId String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roleTemplate    RoleTemplate            @relation(fields: [roleTemplateId], references: [id])
  courierTrips    DeliveryTrip[]
  courierLocation CourierLocation?
  locationSamples CourierLocationSample[]

  @@unique([userId, restaurantId])
  @@index([restaurantId, status])
  @@map("memberships")
}

model InviteToken {
  id              String        @id @default(uuid())
  restaurantId    String
  createdByUserId String
  phone           String
  fullName        String
  roleTemplateId  String
  token           String        @unique
  channel         InviteChannel @default(SHOWN)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([restaurantId, phone])
  @@map("invite_tokens")
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  /// Gross price in the restaurant currency's minor unit, VAT included.
  priceMinor   Int
  currency     String
  vatRateBps   Int
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([restaurantId, categoryId, sortOrder])
  @@map("menu_items")
}

model ModifierGroup {
  id         String   @id @default(uuid())
  menuItemId String
  name       String
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceDeltaMinor Int      @default(0)
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// ---------------------------------------------------------------------------
// Table QR: the acquisition surface (docs/MASA_QR.md)
// ---------------------------------------------------------------------------

model DiningTable {
  id           String   @id @default(uuid())
  restaurantId String
  branchId     String
  label        String
  /// Printed in the QR; rotating it invalidates old stickers.
  qrToken      String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scanEvents QrScanEvent[]
  orders     Order[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@map("dining_tables")
}

model QrScanEvent {
  id           String        @id @default(uuid())
  restaurantId String
  tableId      String?
  /// Anonymous browser session; never a phone number.
  sessionId    String
  outcome      QrScanOutcome
  userId       String?
  orderId      String?
  createdAt    DateTime      @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([sessionId])
  @@map("qr_scan_events")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model CustomerAddress {
  id          String   @id @default(uuid())
  userId      String
  label       String
  addressLine String
  city        String
  district    String
  postalCode  String?
  lat         Float?
  lng         Float?
  note        String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

/// The restaurant's own customer list: the lock-in of the SaaS layer. One row per (restaurant, user).
model RestaurantCustomer {
  id                 String       @id @default(uuid())
  restaurantId       String
  userId             String
  firstChannel       OrderChannel
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  orderCount         Int          @default(0)
  lifetimeGrossMinor Int          @default(0)
  tags               String[]     @default([])
  note               String?
  marketingOptIn     Boolean      @default(false)
  /// When the customer gave or withdrew marketing consent (docs/KAMPANYALAR.md); the flag is the current state.
  marketingOptInAt   DateTime?
  marketingOptOutAt  DateTime?
  /// Unguessable handle of the one-click opt-out link in every campaign message.
  marketingToken     String?      @unique
  /// Loyalty balance (docs/SADAKAT.md); every change is a loyalty_transactions row.
  loyaltyPoints      Int          @default(0)
  /// First time the customer earned points here; the welcome bonus is paid once, at that moment.
  loyaltyJoinedAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignRecipients  CampaignRecipient[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([restaurantId, userId])
  @@index([restaurantId, lastOrderAt])
  @@index([restaurantId, marketingOptIn])
  @@map("restaurant_customers")
}

/// A marketing send to a segment of the restaurant's own opted-in customers (PRO, docs/KAMPANYALAR.md).
model Campaign {
  id              String         @id @default(uuid())
  restaurantId    String
  name            String
  channel         MessageChannel
  body            String
  status          CampaignStatus @default(DRAFT)
  /// CampaignSegmentSchema in shared: who receives it.
  segment         Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  audienceCount   Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  skippedCount    Int            @default(0)
  /// Why the runner paused (INSUFFICIENT_CREDITS) or the last provider error.
  lastError       String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([restaurantId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// A named audience filter the restaurant reuses across campaigns (CampaignSegmentSchema in shared).
model CampaignSegmentPreset {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  segment      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("campaign_segments")
}

/// A restaurant's API key (docs/API_ERISIMI.md): the secret is stored only as a hash; the key holds a permission subset.
model RestaurantApiKey {
  id              String    @id @default(uuid())
  restaurantId    String
  /// Public lookup part of the token (rsk_<keyId>_<secret>).
  keyId           String    @unique
  name            String
  secretHash      String
  permissions     String[]  @default([])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("restaurant_api_keys")
}

/// The customer's rating of a completed order (docs/VITRIN.md); one per order, given from the tracking page.
model OrderRating {
  id           String   @id @default(uuid())
  orderId      String   @unique
  restaurantId String
  score        Int
  comment      String?
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("order_ratings")
}

/// A URL the restaurant's own system receives order changes at (docs/API_ERISIMI.md); the signing secret is encrypted.
model RestaurantWebhook {
  id              String    @id @default(uuid())
  restaurantId    String
  url             String
  events          String[]  @default([])
  secretEncrypted String
  isActive        Boolean   @default(true)
  /// Consecutive failed deliveries; the hook pauses itself past the limit.
  failureCount    Int       @default(0)
  lastDeliveryAt  DateTime?
  lastStatus      Int?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([restaurantId, createdAt])
  @@map("restaurant_webhooks")
}

/// One attempt chain of one event to one webhook; retried with backoff by the runner.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  restaurantId   String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  responseStatus Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  sentAt         DateTime?

  webhook RestaurantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model CampaignRecipient {
  id           String                  @id @default(uuid())
  campaignId   String
  customerId   String
  status       CampaignRecipientStatus @default(PENDING)
  messageLogId String?
  errorCode    String?
  sentAt       DateTime?
  createdAt    DateTime                @default(now())

  campaign Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Orders and money (docs/MUTABAKAT.md)
// ---------------------------------------------------------------------------

/// Loyalty rules of one restaurant (docs/SADAKAT.md); a PRO feature, the row stays when the plan lapses.
model LoyaltyProgram {
  id               String   @id @default(uuid())
  restaurantId     String   @unique
  enabled          Boolean  @default(false)
  earnPoints       Int      @default(1)
  earnStepMinor    Int
  redeemPoints     Int      @default(100)
  redeemValueMinor Int
  minOrderMinor    Int      @default(0)
  maxDiscountBps   Int      @default(5000)
  welcomePoints    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

/// Append-only point movements; the customer's loyaltyPoints is the running balance.
model LoyaltyTransaction {
  id              String                 @id @default(uuid())
  restaurantId    String
  customerId      String
  orderId         String?
  type            LoyaltyTransactionType
  /// Signed: positive earns, negative spends.
  points          Int
  balanceAfter    Int
  memo            String?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([orderId, type])
  @@map("loyalty_transactions")
}

model Order {
  id             String          @id @default(uuid())
  restaurantId   String
  branchId       String
  customerUserId String?
  tableId        String?
  channel        OrderChannel
  fulfillment    FulfillmentType
  deliveryMode   DeliveryMode    @default(NONE)
  status         OrderStatus     @default(PLACED)
  currency       String

  // Amounts in minor units, snapshot of computeOrderSettlement() at placement.
  itemsGrossMinor         Int
  itemsVatMinor           Int
  deliveryFeeMinor        Int            @default(0)
  discountMinor           Int            @default(0)
  discountFundedBy        String?
  chargedToCustomerMinor  Int
  commissionBps           Int
  platformCommissionMinor Int
  commissionVatMinor      Int            @default(0)
  pspFeeMinor             Int            @default(0)
  pspFeeBearer            String         @default("RESTAURANT")
  withholdingMinor        Int            @default(0)
  courierCostMinor        Int            @default(0)
  courierBearer           String?
  restaurantPayableMinor  Int
  /// Payment mode at placement; decides whether the commission is invoiced (OWN_POS) or deducted (PLATFORM_PSP).
  paymentMode             PaymentMode    @default(OWN_POS)
  /// OWN_POS: commission + VAT the restaurant owes for this order. PLATFORM_PSP: 0.
  platformReceivableMinor Int            @default(0)
  /// Payment intent at placement (docs/YEMEK_KARTI.md); the payments rows carry what actually happened.
  paymentMethod           PaymentMethod?
  /// Meal card issuer code when paymentMethod is MEAL_CARD.
  paymentProvider         String?

  /// Delivery address at the time of the order (never a live reference).
  addressSnapshot     Json?
  customerNote        String?
  rejectReason        String?
  /// Unguessable handle of the public tracking page (/t/<token>); set for every new order.
  trackingToken       String?   @unique
  /// Kitchen promise given when the order was accepted (placedAt + prepMinutes).
  promisedReadyAt     DateTime?
  /// PLACED orders: placedAt + the restaurant's acceptTimeoutMinutes; the watchdog alarms past it (docs/SIPARIS_VE_SEVK.md).
  acceptDeadlineAt    DateTime?
  /// Set once the overdue alarm went out, so it goes out once.
  acceptAlertSentAt   DateTime?
  /// Latest delivery estimate, recomputed from the courier's position while on the way.
  estimatedDeliveryAt DateTime?
  placedAt            DateTime  @default(now())
  acceptedAt          DateTime?
  readyAt             DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  customer            User?                @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  table               DiningTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  ledgerEntries       LedgerEntry[]
  loyaltyTransactions LoyaltyTransaction[]
  rating              OrderRating?
  deliveryRequest     DeliveryRequest?
  deliveryStops       DeliveryStop[]

  @@index([restaurantId, placedAt])
  @@index([restaurantId, status])
  @@index([status, acceptDeadlineAt])
  @@index([customerUserId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  menuItemId        String?
  nameSnapshot      String
  unitPriceMinor    Int
  quantity          Int
  vatRateBps        Int
  /// Chosen modifiers as [{ name, priceDeltaMinor }].
  modifiersSnapshot Json?
  lineTotalMinor    Int
  /// Position in the basket, so receipts and screens list items as the customer entered them.
  position          Int     @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  reason      String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                   String        @id @default(uuid())
  restaurantId         String
  orderId              String
  provider             String
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amountMinor          Int
  currency             String
  /// The PSP's own fee as reported in its settlement, when known.
  pspFeeMinor          Int?
  providerRef          String?
  capturedAt           DateTime?
  refundedMinor        Int           @default(0)
  /// Which merchant collected: the restaurant's own POS or the platform's PSP, as it was at payment time.
  paymentMode          PaymentMode   @default(OWN_POS)
  /// The stored card used, when the customer paid with a saved card.
  savedPaymentMethodId String?
  /// Staff member or courier who recorded a collection at the door or the counter.
  collectedByUserId    String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  savedPaymentMethod SavedPaymentMethod? @relation(fields: [savedPaymentMethodId], references: [id], onDelete: SetNull)
  collectedBy        User?               @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([providerRef])
  @@map("payments")
}

/// A restaurant's own virtual POS (docs/ODEME.md). Credentials are encrypted
/// with the platform key (AES-256-GCM; envelope encryption with a KMS in
/// production) and never leave the API.
model PaymentProviderConnection {
  id                   String                  @id @default(uuid())
  restaurantId         String                  @unique
  providerCode         String
  encryptedCredentials String
  /// Identifies the key that encrypted the credentials, so keys can be rotated.
  keyVersion           String
  status               PaymentConnectionStatus @default(PENDING_VERIFICATION)
  /// Masked identification shown in the panel, e.g. "PAYTR ****1234".
  label                String
  lastVerifiedAt       DateTime?
  failureReason        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_provider_connections")
}

/// A customer's card as held by a vault provider; only the provider's token is stored, encrypted.
/// How a restaurant accepts one meal card issuer (docs/YEMEK_KARTI.md): at
/// the door, online with the issuer's API credentials (encrypted, verified),
/// or both. The restaurant is the issuer's member merchant, never the platform.
model MealCardConnection {
  id                   String                  @id @default(uuid())
  restaurantId         String
  providerCode         String
  acceptsOnline        Boolean                 @default(false)
  acceptsOnDelivery    Boolean                 @default(true)
  encryptedCredentials String?
  keyVersion           String?
  status               PaymentConnectionStatus @default(DISABLED)
  label                String?
  lastVerifiedAt       DateTime?
  failureReason        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, providerCode])
  @@map("meal_card_connections")
}

model SavedPaymentMethod {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  /// The vault's token, encrypted at rest. Never a card number.
  encryptedToken String
  keyVersion     String
  tokenHash      String
  brand          String
  last4          String
  expiryMonth    Int
  expiryYear     Int
  label          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  billingRestaurants Restaurant[] @relation("RestaurantBillingCard")

  @@unique([userId, provider, tokenHash])
  @@index([userId])
  @@map("saved_payment_methods")
}

/// Monthly commission invoice of an OWN_POS restaurant: the commission and
/// VAT snapshotted on each paid order of the month, collected afterwards.
model CommissionInvoice {
  id                  String                  @id @default(uuid())
  restaurantId        String
  periodStart         DateTime
  periodEnd           DateTime
  currency            String
  orderCount          Int
  baseMinor           Int
  commissionMinor     Int
  vatMinor            Int
  totalMinor          Int
  status              CommissionInvoiceStatus @default(DRAFT)
  issuedAt            DateTime?
  dueAt               DateTime?
  paidAt              DateTime?
  /// Reference of the collection (card charge or bank transfer).
  paymentRef          String?
  /// The saved card the collection used, when it was a card.
  paymentMethodId     String?
  /// Fiscal document (e-Arsiv or the regional equivalent) issued by the invoice provider adapter.
  fiscalRef           String?
  fiscalDocumentUrl   String?
  /// Automatic collection bookkeeping (docs/FATURALAMA.md): attempts, the last one and why it failed.
  collectionAttempts  Int                     @default(0)
  lastCollectionAt    DateTime?
  lastCollectionError String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([restaurantId, periodStart])
  @@index([restaurantId, status])
  @@index([status, dueAt])
  @@map("commission_invoices")
}

/// Append-only. Amounts are signed from the restaurant's point of view.
model LedgerEntry {
  id           String          @id @default(uuid())
  restaurantId String
  orderId      String?
  payoutId     String?
  invoiceId    String?
  type         LedgerEntryType
  amountMinor  Int
  currency     String
  occurredAt   DateTime        @default(now())
  memo         String?

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payout     Payout?            @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  invoice    CommissionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([restaurantId, occurredAt])
  @@index([orderId])
  @@index([payoutId])
  @@index([invoiceId])
  @@map("ledger_entries")
}

/// A transfer of accumulated restaurant payables. Scheduled within the legal payment deadline of the region.
model Payout {
  id            String       @id @default(uuid())
  restaurantId  String
  periodStart   DateTime
  periodEnd     DateTime
  amountMinor   Int
  currency      String
  status        PayoutStatus @default(SCHEDULED)
  scheduledFor  DateTime
  sentAt        DateTime?
  settledAt     DateTime?
  providerRef   String?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([restaurantId, scheduledFor])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Plans and message credits (docs/FIYATLANDIRMA.md)
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(uuid())
  /// BASIC or PRO (PLAN_CODES in shared); prices are data, the vocabulary is code.
  code              String   @unique
  name              String
  monthlyPriceMinor Int
  currency          String
  isFree            Boolean  @default(false)
  trialDays         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions RestaurantSubscription[]

  @@map("plans")
}

model RestaurantSubscription {
  id               String             @id @default(uuid())
  restaurantId     String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@map("restaurant_subscriptions")
}

model MessageCreditPackage {
  id         String         @id @default(uuid())
  code       String         @unique
  channel    MessageChannel
  credits    Int
  priceMinor Int
  currency   String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@map("message_credit_packages")
}

model MessageWallet {
  id           String         @id @default(uuid())
  restaurantId String
  channel      MessageChannel
  balance      Int            @default(0)
  updatedAt    DateTime       @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions MessageTransaction[]

  @@unique([restaurantId, channel])
  @@map("message_wallets")
}

model MessageTransaction {
  id           String                 @id @default(uuid())
  walletId     String
  type         MessageTransactionType
  delta        Int
  balanceAfter Int
  /// Package code, message log id or an admin note.
  reference    String?
  createdAt    DateTime               @default(now())

  wallet MessageWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("message_transactions")
}

/// One attempted message. Credits are debited only when status reaches SENT.
model MessageLog {
  id             String         @id @default(uuid())
  restaurantId   String?
  channel        MessageChannel
  /// Masked for display; the full number is never logged.
  toMasked       String
  templateKey    String
  status         MessageStatus  @default(PENDING)
  provider       String
  providerRef    String?
  creditsCharged Int            @default(0)
  errorCode      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("message_logs")
}

// ---------------------------------------------------------------------------
// Courier networks (docs/KURYE.md)
// ---------------------------------------------------------------------------

model CourierProvider {
  id          String   @id @default(uuid())
  /// Adapter key registered in the API (MOCK in development).
  code        String   @unique
  name        String
  countryCode String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  restaurants      Restaurant[]
  deliveryRequests DeliveryRequest[]

  @@map("courier_providers")
}

model DeliveryRequest {
  id                String                @id @default(uuid())
  restaurantId      String
  orderId           String                @unique
  providerId        String
  status            DeliveryRequestStatus @default(QUOTED)
  quoteId           String?
  quoteFeeMinor     Int
  finalFeeMinor     Int?
  currency          String
  providerRef       String?
  trackingUrl       String?
  pickupEtaMinutes  Int?
  dropoffEtaMinutes Int?
  failureReason     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   CourierProvider @relation(fields: [providerId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([providerRef])
  @@map("delivery_requests")
}

// ---------------------------------------------------------------------------
// Compliance and platform
// ---------------------------------------------------------------------------

/// A courier's run from the restaurant with one or more orders. Owned by the
/// restaurant; the courier is a membership with the courier.deliver permission.
model DeliveryTrip {
  id                     String             @id @default(uuid())
  restaurantId           String
  branchId               String
  courierMembershipId    String?
  createdByUserId        String?
  status                 DeliveryTripStatus @default(PLANNED)
  sequenceMode           StopSequenceMode   @default(MANUAL)
  /// Planned road distance and travel time over all stops, from the routing adapter.
  plannedDistanceMeters  Int?
  plannedDurationSeconds Int?
  assignedAt             DateTime?
  pickedUpAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch          Branch                  @relation(fields: [branchId], references: [id])
  courier         Membership?             @relation(fields: [courierMembershipId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  stops           DeliveryStop[]
  locationSamples CourierLocationSample[]

  @@index([restaurantId, status])
  @@index([courierMembershipId, status])
  @@map("delivery_trips")
}

/// One order inside a trip, in delivery sequence. An order can appear in
/// several trips over its life (a failed delivery is re-dispatched) but in at
/// most one active trip, which the service enforces.
model DeliveryStop {
  id             String             @id @default(uuid())
  tripId         String
  restaurantId   String
  orderId        String
  sequence       Int
  status         DeliveryStopStatus @default(PENDING)
  /// Destination snapshot copied from the order address at the time the stop was added.
  lat            Float?
  lng            Float?
  /// Latest estimate for this stop: cumulative road distance and arrival time.
  distanceMeters Int?
  etaAt          DateTime?
  arrivedAt      DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  trip       DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tripId, sequence])
  @@index([orderId, status])
  @@map("delivery_stops")
}

/// Latest known position of a courier, one row per membership, overwritten on
/// every ping. Only accepted while the courier has an active trip.
model CourierLocation {
  membershipId String   @id
  restaurantId String
  tripId       String?
  lat          Float
  lng          Float
  headingDeg   Float?
  speedMps     Float?
  accuracyM    Float?
  recordedAt   DateTime
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("courier_locations")
}

/// Downsampled trail of a trip (for disputes and the trip replay); append-only.
model CourierLocationSample {
  id           String   @id @default(uuid())
  tripId       String
  membershipId String
  lat          Float
  lng          Float
  recordedAt   DateTime
  createdAt    DateTime @default(now())

  trip       DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  membership Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("courier_location_samples")
}

model DocumentVersion {
  id          String       @id @default(uuid())
  type        DocumentType
  version     String
  locale      String
  body        String
  publishedAt DateTime     @default(now())

  consents Consent[]

  @@unique([type, version, locale])
  @@map("document_versions")
}

model Consent {
  id                String   @id @default(uuid())
  userId            String
  documentVersionId String
  acceptedAt        DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@index([userId])
  @@map("consents")
}

model FeatureFlag {
  id           String           @id @default(uuid())
  key          String
  scope        FeatureFlagScope
  restaurantId String?
  enabled      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([key, scope, restaurantId])
  @@map("feature_flags")
}

model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String?
  actorUserId  String?
  action       String
  entity       String
  entityId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}
