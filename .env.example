# Server environment template. Copy to /opt/resget/.env on the host and fill in.
# Generate secrets with: openssl rand -hex 32
# Never commit the real file. Every key below reaches its container through
# deploy/docker-compose.prod.yml. Optional keys may stay empty: an empty value
# means "not set" and the adapter falls back to its safe default (MOCK where
# that exists; in production most MOCKs refuse instead of pretending to succeed).
# [SIDE EFFECT] marks keys that make the platform talk to a real external
# service (real SMS, payments, courier requests).

# -- Required ---------------------------------------------------------------

# Images published by CI (lowercase owner/repo)
IMAGE_REPO=ghcr.io/<owner>/resget
# Used by scripts/nightly-deploy.sh (pull-based deploys)
GIT_REMOTE=https://github.com/<owner>/resget.git

# Public hostnames served by Caddy (automatic TLS)
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# production (default) or preprod. preprod adds "X-Robots-Tag: noindex, nofollow".
SITE_ENV=production

# PostgreSQL
POSTGRES_USER=resget
POSTGRES_DB=resget
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# API (at least 32 characters)
JWT_SECRET=

# -- Messaging: SMS -----------------------------------------------------------
# MOCK, NETGSM, ILETI_MERKEZI or TWILIO. [SIDE EFFECT] with credentials.
SMS_PROVIDER=MOCK
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=
ILETI_MERKEZI_USER=
ILETI_MERKEZI_PASSWORD=
ILETI_MERKEZI_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -- Messaging: WhatsApp Cloud API ---------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -- Payments (docs/ODEME.md) -------------------------------------------------
# Key encrypting restaurants' POS credentials and card vault tokens at rest:
# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# Rotate by introducing a new key version (KeyProvider), never by replacing in place.
CREDENTIAL_ENCRYPTION_KEY=
# Card vault customers' cards are stored with: MOCK (development), MASTERPASS or BEX (BKM).
CARD_VAULT_PROVIDER=MASTERPASS
MASTERPASS_CLIENT_ID=
MASTERPASS_CLIENT_SECRET=
BEX_MERCHANT_ID=
BEX_MERCHANT_SECRET=
# The platform's own PSP merchant for PLATFORM_PSP restaurants (OWN_POS
# restaurants bring their own). MOCK (default), IYZICO, PAYTR or STRIPE; MOCK is refused in production.
PAYMENT_PROVIDER=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- Routing (ETAs and shortest route of own-courier trips) -----------------
# HAVERSINE (default): straight-line distance times the restaurant's detour
# factor. A road engine is added as an adapter in apps/api/src/modules/dispatch.
ROUTING_PROVIDER=HAVERSINE

# -- Courier (third-party courier networks reached over their APIs) ----------
# MOCK (default) or a provider code registered in apps/api/src/modules/courier.
COURIER_PROVIDER=MOCK
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=

# -- Database backups (deploy/scripts/backup.sh, docs/CICD_GUIDE.md) --------
# Any S3-compatible storage; leave BACKUP_S3_BUCKET empty to keep local copies
# only (14 days on this server). When the bucket is set, the access key, the
# secret and BACKUP_ENCRYPTION_KEY are required. Keep BACKUP_ENCRYPTION_KEY
# (openssl rand -hex 32) somewhere other than this server too: without it the
# off-site copies cannot be restored.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=

# -- Compose-derived variables (do not set by hand) ---------------------------
# NODE_ENV, PORT, DATABASE_URL, REDIS_URL, CORS_ORIGIN, PUBLIC_APP_URL,
# PUBLIC_API_URL, API_INTERNAL_URL and APP_RELEASE are computed in
# deploy/docker-compose.prod.yml from the values above.

# Platform bootstrap (docs/PLATFORM_YONETIMI.md). deploy.sh runs
# `node dist/cli/bootstrap.js --defaults-only` after every migration: plans
# are created once in this currency and never overwritten afterwards.
BOOTSTRAP_CURRENCY=TRY
BOOTSTRAP_PRO_PRICE_MINOR=0
# First super admin: run once by hand on the server, never from deploy.sh:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api \
#     node dist/cli/bootstrap.js --super-admin-phone=+905xxxxxxxxx --super-admin-name="Ad Soyad"

# Unauthenticated writes per client per 10 minutes (docs/VITRIN.md)
# Daily commission billing job inside the API (docs/FATURALAMA.md): on | off (off when cron runs dist/cli/billing.js)
# Directory for uploaded files (restaurant logos); a named volume in production, ./uploads in development
UPLOADS_DIR=
BILLING_SCHEDULER=on
# Acceptance watchdog inside the API (docs/SIPARIS_VE_SEVK.md): on | off
ORDER_WATCHDOG=on
# Campaign queue inside the API (docs/KAMPANYALAR.md): on | off
CAMPAIGN_RUNNER=on
# Regional commercial-message consent registry (Turkey: IYS); MOCK until contracted
CONSENT_REGISTRY_PROVIDER=MOCK
# Fiscal document integrator for commission invoices; MOCK until an integrator contract exists
INVOICE_PROVIDER=MOCK
PUBLIC_ORDER_RATE_LIMIT=10
PUBLIC_FUNNEL_RATE_LIMIT=60
