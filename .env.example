# Server environment template. Copy to /opt/resget/.env on the host and fill in.
# Generate secrets with: openssl rand -hex 32
# Never commit the real file. Every key below reaches its container through
# deploy/docker-compose.prod.yml. Optional keys may stay empty: an empty value
# means "not set" and the adapter falls back to its safe default (MOCK where
# that exists; in production most MOCKs refuse instead of pretending to succeed).
# [SIDE EFFECT] marks keys that make the platform talk to a real external
# service (real SMS, payments, courier requests).

# -- Required ---------------------------------------------------------------

# Images published by CI (lowercase owner/repo)
IMAGE_REPO=ghcr.io/<owner>/resget
# Used by scripts/nightly-deploy.sh (pull-based deploys)
GIT_REMOTE=https://github.com/<owner>/resget.git

# Public hostnames served by Caddy (automatic TLS)
WEB_DOMAIN=app.example.com
# Restaurants' custom domains are verified against real DNS (DNS) or a stand-in for tests (MOCK).
# DOMAIN_VERIFIER=DNS
# Outbound webhooks (docs/API_ERISIMI.md): the in-process delivery runner and the per-key request limit per minute.
# WEBHOOK_RUNNER=on
# API_KEY_RATE_LIMIT=600
# Hourly SMS reminder to the owner 7 days before an API key expires: on | off
# API_KEY_EXPIRY_NOTICES=on
# How often an open order / dispatch / courier event stream re-checks its subscriber's access, in seconds
# (docs/SIPARIS_VE_SEVK.md, "Canlı akış yetkisi"); 60 when unset.
# REALTIME_REAUTH_SECONDS=60
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# production (default) or preprod. preprod adds "X-Robots-Tag: noindex, nofollow".
SITE_ENV=production

# PostgreSQL
POSTGRES_USER=resget
POSTGRES_DB=resget
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# API (at least 32 characters)
JWT_SECRET=

# -- Messaging: email (docs/EPOSTA.md) ------------------------------------------
# MOCK accepts outside production and refuses in it; SES sends. [SIDE EFFECT] with credentials.
EMAIL_PROVIDER=MOCK
# SES_REGION=eu-central-1
# The platform's own sender for transactional mail of restaurants without a verified domain.
# SES_FROM_ADDRESS=bildirim@example.com
# SES_CONFIGURATION_SET=
# SNS topics whose bounce and complaint notifications are accepted, comma separated.
# SES_SNS_TOPIC_ARNS=
# AWS credentials are read by the SDK from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an instance role.

# -- Ad platforms (docs/REKLAM.md) ---------------------------------------------
# MOCK accepts outside production and refuses in it; LIVE calls Meta, Google Ads and TikTok. [SIDE EFFECT]
ADS_PROVIDER=MOCK
# Google Ads API app credentials; each business connects with its own refresh token.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# -- IndexNow (docs/SEO.md) ----------------------------------------------------
# NONE does nothing, MOCK only records, LIVE pings api.indexnow.org when public pages change. [SIDE EFFECT]
INDEXNOW_PROVIDER=NONE
# 8 to 128 letters, digits or dashes; the same value goes to the web app, which serves it.
# INDEXNOW_KEY=

# -- Integration hub: Meta OAuth (docs/ENTEGRASYON_MERKEZI.md) --------------------
# NONE switches it off, MOCK fakes the consent round trip (not in production), LIVE talks to Meta. [SIDE EFFECT]
META_PROVIDER=NONE
# Register <PUBLIC_APP_URL>/api/oauth/meta/callback as the valid OAuth redirect URI in the Meta app (a web route,
# not the API): the round trip finishes only in the browser that started it.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0
# Lead Ads webhook (docs/LEAD_ADS.md): any random value of 16+ characters, entered in the Meta app's webhook settings.
# Deliveries are verified with META_APP_SECRET; without it every delivery is refused.
# META_WEBHOOK_VERIFY_TOKEN=

# -- AI studio (docs/YAPAY_ZEKA.md) ---------------------------------------------
# NONE switches drafting off, MOCK returns fixed drafts (not in production), ANTHROPIC drafts with Claude. [SIDE EFFECT, COST]
AI_PROVIDER=NONE
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Monthly token budget of a tenant without its own (set per tenant in the console).
# AI_DEFAULT_MONTHLY_TOKENS=200000

# -- Messaging: SMS -----------------------------------------------------------
# MOCK, NETGSM, ILETI_MERKEZI or TWILIO. [SIDE EFFECT] with credentials.
SMS_PROVIDER=MOCK
# Push notifications to the app: MOCK outside production, EXPO in production (optional EXPO_ACCESS_TOKEN).
PUSH_PROVIDER=MOCK
# EXPO_ACCESS_TOKEN=
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=
ILETI_MERKEZI_USER=
ILETI_MERKEZI_PASSWORD=
ILETI_MERKEZI_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -- Messaging: WhatsApp Cloud API ---------------------------------------------
# MOCK or META (WhatsApp Business Cloud API; needs the two values below).
WHATSAPP_PROVIDER=MOCK
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -- Payments (docs/ODEME.md) -------------------------------------------------
# Key encrypting restaurants' POS credentials and card vault tokens at rest:
# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# Rotate by introducing a new key version (KeyProvider), never by replacing in place.
CREDENTIAL_ENCRYPTION_KEY=
# Card vault customers' cards are stored with: MOCK (development), MASTERPASS or BEX (BKM).
# Production refuses card linking and charging until the adapter for this value ships
# (docs/CANLIYA_GECIS.md); invoices are paid by bank transfer meanwhile.
CARD_VAULT_PROVIDER=MASTERPASS
MASTERPASS_CLIENT_ID=
MASTERPASS_CLIENT_SECRET=
BEX_MERCHANT_ID=
BEX_MERCHANT_SECRET=
# The platform's own PSP merchant for PLATFORM_PSP restaurants (OWN_POS
# restaurants enter their own credentials in the panel; the same adapters
# serve both). MOCK (default), IYZICO, PAYTR or STRIPE; MOCK is refused in production.
# IYZICO_BASE_URL selects the sandbox (https://sandbox-api.iyzipay.com) when testing.
PAYMENT_PROVIDER=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- Routing (ETAs and shortest route of own-courier trips) -----------------
# HAVERSINE (default): straight-line distance times the restaurant's detour
# factor. OSRM: road distances and durations from an OSRM server (legs and
# the optimiser's distance matrix), straight line when it does not answer.
# The public demo server is for development only; production runs its own.
ROUTING_PROVIDER=HAVERSINE
# OSRM_BASE_URL=https://router.project-osrm.org

# -- Courier (third-party courier networks reached over their APIs) ----------
# MOCK (default, development and tests only: production offers no network for it)
# or a provider code registered in apps/api/src/modules/courier. A real network needs
# COURIER_API_KEY and COURIER_WEBHOOK_SECRET in production.
COURIER_PROVIDER=MOCK
# Address geocoding (docs/VITRIN.md): NONE, MOCK (development and tests only),
# NOMINATIM (OpenStreetMap) or GOOGLE (Geocoding API, server-side key).
# GEOCODER_PROVIDER=NOMINATIM
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# GOOGLE_MAPS_API_KEY=
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=

# -- Database backups (deploy/scripts/backup.sh, docs/CICD_GUIDE.md) --------
# Any S3-compatible storage; leave BACKUP_S3_BUCKET empty to keep local copies
# only (14 days on this server). When the bucket is set, the access key, the
# secret and BACKUP_ENCRYPTION_KEY are required. Keep BACKUP_ENCRYPTION_KEY
# (openssl rand -hex 32) somewhere other than this server too: without it the
# off-site copies cannot be restored.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=

# -- Maps (web) ---------------------------------------------------------------
# Tile URL template and the attribution the provider requires. Empty means
# OpenStreetMap's public tiles, fine for development and small deployments
# (their usage policy applies); point production at a tile provider.
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAP_MAX_ZOOM=

# -- Mobile app universal links (web) ------------------------------------------
# Served at /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# once set; empty keeps them absent and tracking links open in the browser.
# IOS_APP_IDENTIFIER is TEAMID.bundle; fingerprints are SHA-256, comma separated.
IOS_APP_IDENTIFIER=
ANDROID_PACKAGE_NAME=com.resget.app
ANDROID_CERT_FINGERPRINTS=

# -- Compose-derived variables (do not set by hand) ---------------------------
# NODE_ENV, PORT, DATABASE_URL, REDIS_URL, CORS_ORIGIN, PUBLIC_APP_URL,
# PUBLIC_API_URL, API_INTERNAL_URL and APP_RELEASE are computed in
# deploy/docker-compose.prod.yml from the values above.

# Platform bootstrap (docs/PLATFORM_YONETIMI.md). deploy.sh runs
# `node dist/cli/bootstrap.js --defaults-only` after every migration: plans
# are created once in this currency and never overwritten afterwards.
BOOTSTRAP_CURRENCY=TRY
BOOTSTRAP_PRO_PRICE_MINOR=0
# First super admin: run once by hand on the server, never from deploy.sh:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api \
#     node dist/cli/bootstrap.js --super-admin-phone=+905xxxxxxxxx --super-admin-name="Ad Soyad"

# Unauthenticated writes per client per 10 minutes (docs/VITRIN.md)
# Daily commission billing job inside the API (docs/FATURALAMA.md): on | off (off when cron runs dist/cli/billing.js)
# Directory for uploaded files (restaurant logos); a named volume in production, ./uploads in development
UPLOADS_DIR=
BILLING_SCHEDULER=on
# Acceptance watchdog inside the API (docs/SIPARIS_VE_SEVK.md): on | off
ORDER_WATCHDOG=on
# Campaign queue inside the API (docs/KAMPANYALAR.md): on | off
CAMPAIGN_RUNNER=on
# Retry sweep for refunds of cancelled online orders inside the API (docs/ODEME.md 3b): on | off
REFUND_RETRY=on
# Regional commercial-message consent registry (Turkey: IYS). MOCK outside production; in
# production covered channels send nothing until the real adapter ships (docs/CANLIYA_GECIS.md).
CONSENT_REGISTRY_PROVIDER=MOCK
# Fiscal document integrator for commission invoices. MOCK outside production; in production
# invoices wait without a fiscal number until the integrator adapter ships.
INVOICE_PROVIDER=MOCK
PUBLIC_ORDER_RATE_LIMIT=10
PUBLIC_FUNNEL_RATE_LIMIT=60
# Sign-in code requests and verifications per client address per 10 minutes (docs/GUVENLIK.md)
PUBLIC_OTP_RATE_LIMIT=30
